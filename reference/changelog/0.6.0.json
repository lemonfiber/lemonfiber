      "title": "New",
      "entries": [
        {
          "summary": "Tell the spec when a release is published",
          "requirements": ["GOV-R12"],
          "reference": "#209"
        },
        {
          "summary": "Notice the stall nobody owns, and say which kind it is",
          "requirements": ["C7-R1", "C7-R2", "C7-R3", "C7-R5", "C7-R6", "C7-R7", "C7-R12"],
          "reference": "#210"
        },
        {
          "summary": "Ask more than one address service, and report when they disagree",
          "requirements": ["C7-R1", "C7-R2", "C7-R3", "C7-R5", "C7-R6", "C7-R7", "C7-R12", "C2-R14"],
          "reference": "#211"
        },
        {
          "summary": "Read the items, not just how many there are",
          "requirements": ["C7-R9", "C7-R15"],
          "reference": "#213"
        },
        {
          "summary": "Watch the pipeline across the services that each see half of it",
          "requirements": ["C7-R8", "C7-R11", "C7-R13", "C7-R14"],
          "reference": "#214"
        },
        {
          "summary": "Move the download client onto the port the provider granted",
          "requirements": ["C2-R4", "C2-R5", "C2-R19"],
          "reference": "#216"
        },
        {
          "summary": "Tell the arrs to copy where the volume cannot link",
          "requirements": ["C5-R3", "C5-R4", "C5-R12"],
          "reference": "#217"
        },
        {
          "summary": "Re-check the tunnel while traffic is moving",
          "requirements": ["C2-R9", "C2-R10"],
          "reference": "#218"
        },
        {
          "summary": "Warn about torrents nothing contains, and let it be answered",
          "requirements": ["C2-R13", "C2-R17", "C2-R20"],
          "reference": "#219"
        },
        {
          "summary": "Refuse a stack that splits the data root across mounts",
          "requirements": ["C5-R5"],
          "reference": "#220"
        },
        {
          "summary": "Read the history behind the queue, and attribute one cause once",
          "requirements": ["C7-R4", "C7-R9", "C7-R10"],
          "reference": "#221"
        },
        {
          "summary": "The screen the model has been waiting for",
          "requirements": ["B3-R1", "B3-R4"],
          "reference": "#224"
        },
        {
          "summary": "Make the refresh the thing that drives the checks",
          "requirements": ["B5-R4", "B5-R13", "C7-R8"],
          "reference": "#229"
        }
      ]
    },
    {
      "title": "Fixed",
      "entries": [
        {
          "summary": "Stop the compose walk following a link back to an ancestor",
          "requirements": ["C5-R5"],
          "reference": "#223"
        },
        {
          "summary": "Stop text from elsewhere instructing the terminal, and keep one record reader",
          "requirements": ["GOV-R12"],
          "reference": "#225"
        }
      ]
    },
    {
      "title": "Maintenance",
      "entries": [
        {
          "summary": "Record what landed, and stop crediting what did not",
