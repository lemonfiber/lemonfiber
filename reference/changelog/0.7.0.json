      "title": "New",
      "entries": [
        {
          "summary": "Track what the accounts have left, not only that they work",
          "requirements": ["C8-R1", "C8-R3", "C8-R4", "C8-R6", "C8-R7", "C8-R10", "C8-R11", "C8-R13", "C8-R14"],
          "reference": "#232"
        },
        {
          "summary": "Tell an account that refused from one that never answered",
          "requirements": ["C8-R2", "C8-R9", "C8-R11", "C8-R12"],
          "reference": "#233"
        },
        {
          "summary": "Say when an indexer's allowance comes back",
          "requirements": ["C8-R5"],
          "reference": "#234"
        },
        {
          "summary": "Let the accounts answer when nothing was found or taken",
          "requirements": ["C8-R8"],
          "reference": "#235"
        },
        {
          "summary": "Let a few things through rather than take the secrets out",
          "requirements": ["C4-R2", "C4-R3", "C4-R4", "C4-R5"],
          "reference": "#236"
        },
        {
          "summary": "Gather what can be read and name what cannot",
          "requirements": ["C4-R11", "C4-R12"],
          "reference": "#237"
        },
        {
          "summary": "Read it back before writing it, and refuse rather than write",
          "requirements": ["C4-R4", "C4-R5", "C4-R7", "C4-R10", "C4-R14", "C4-R1", "GOV-R12", "Q-R61"],
          "reference": "#238"
        },
        {
          "summary": "One command, and it describes before it writes",
          "requirements": ["C4-R1", "C4-R6", "C4-R8", "C4-R9", "C4-R13", "GOV-R12", "C4-R2", "C4-R5", "C4-R11"],
          "reference": "#239"
        },
        {
          "summary": "What a repair is, and when one is worth offering",
          "requirements": ["C3-R1", "C3-R4", "C3-R5", "C3-R9", "C3-R10", "C3-R11", "C3-R13", "C3-R14"],
          "reference": "#240"
        },
        {
          "summary": "Offer what can be put right, and prove it afterwards",
          "requirements": ["C3-R1", "C3-R2", "C3-R3", "C3-R4", "C3-R5", "C3-R8", "C3-R9", "C3-R10", "C3-R11", "C3-R12", "C3-R13", "C3-R14", "GOV-R12", "Q-R61"],
          "reference": "#242"
        },
        {
          "summary": "Refuse to write over what the operator set",
          "requirements": ["C3-R7"],
          "reference": "#244"
        },
        {
          "summary": "Put back the repair you just watched",
          "requirements": ["C3-R15"],
          "reference": "#245"
        },
        {
          "summary": "Put right what the operator did not change",
          "requirements": ["C3-R6", "C3-R7", "C9-R15"],
          "reference": "#246"
        }
      ]
    },
    {
      "title": "Fixed",
      "entries": [
