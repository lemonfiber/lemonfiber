{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "One secret, without its value.",
  "type": "object",
  "properties": {
    "from": {
      "description": "Where its value came from, where one is held or granted.",
      "anyOf": [
        {
          "$ref": "SecretFrom.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "held": {
      "description": "Whether a value is held.",
      "type": "boolean"
    },
    "name": {
      "description": "Its name.",
      "type": "string"
    },
    "readers": {
      "description": "Each service that reads it.",
      "type": "array",
      "items": {
        "$ref": "Reader.json"
      }
    },
    "whose": {
      "description": "Whose it is.",
      "$ref": "Owner.json"
    }
  },
  "required": [
    "name",
    "whose",
    "readers",
    "held"
  ]
}
