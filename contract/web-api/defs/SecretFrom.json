{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Where a secret's value came from.",
  "oneOf": [
    {
      "description": "The operator entered it.",
      "type": "string",
      "const": "operator"
    },
    {
      "description": "A recipe captured it.",
      "type": "string",
      "const": "recipe"
    },
    {
      "description": "It is another service's credential, granted to cross.",
      "type": "string",
      "const": "granted"
    }
  ]
}
