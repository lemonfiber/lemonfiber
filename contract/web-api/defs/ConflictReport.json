{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "A port lemonfiber wants for a service that something else already answers on.",
  "type": "object",
  "properties": {
    "held_by": {
      "description": "The project already holding it.",
      "type": "string"
    },
    "port": {
      "description": "The host port both want.",
      "type": "integer",
      "format": "uint16",
      "maximum": 65535,
      "minimum": 0
    },
    "wanted_by": {
      "description": "The lemonfiber service that would publish it.",
      "type": "string"
    }
  },
  "required": [
    "port",
    "wanted_by",
    "held_by"
  ]
}
