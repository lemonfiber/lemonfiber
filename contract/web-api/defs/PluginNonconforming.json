{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "One answer a plugin's adapter gave outside a contract it speaks.",
  "type": "object",
  "properties": {
    "at": {
      "description": "When it answered so, as RFC 3339.",
      "type": "string"
    },
    "capability": {
      "description": "The capability it was asked as.",
      "type": "string"
    },
    "operation": {
      "description": "The operation it was asked.",
      "type": "string"
    },
    "plugin": {
      "description": "The plugin whose adapter answered.",
      "type": "string"
    },
    "why": {
      "description": "What was outside the contract.",
      "type": "string"
    }
  },
  "required": [
    "plugin",
    "capability",
    "operation",
    "why",
    "at"
  ]
}
