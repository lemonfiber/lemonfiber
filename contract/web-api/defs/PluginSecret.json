{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "One credential a plugin says it will hold, without a value and with no place for one.",
  "type": "object",
  "properties": {
    "id": {
      "description": "What the value is, within the plugin.",
      "type": "string"
    },
    "of": {
      "description": "Whose credential it is.",
      "type": "string"
    },
    "why": {
      "description": "What holding it is for.",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "required": [
    "id",
    "of",
    "why"
  ]
}
