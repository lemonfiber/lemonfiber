{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "How one service's update ended.",
  "oneOf": [
    {
      "description": "Updated, and answering again afterwards.",
      "type": "string",
      "const": "updated"
    },
    {
      "description": "The newer image was never fetched, so nothing about this service changed.",
      "type": "string",
      "const": "not-fetched"
    },
    {
      "description": "It was started on the newer image and did not come back.",
      "type": "string",
      "const": "not-started"
    },
    {
      "description": "The run halted before reaching it, so it is standing where it was.",
      "type": "string",
      "const": "not-reached"
    }
  ]
}
