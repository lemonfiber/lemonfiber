{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "One act as a run took it.",
  "type": "object",
  "properties": {
    "act": {
      "description": "The act.",
      "$ref": "Act.json"
    },
    "instead": {
      "description": "What was done in its place, where something weaker was.",
      "anyOf": [
        {
          "$ref": "Act.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "outcome": {
      "description": "What became of it.",
      "$ref": "ActOutcome.json"
    },
    "why": {
      "description": "Why, where it was refused or fell back.",
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "act",
    "outcome"
  ]
}
