{
  "post": {
    "operationId": "profiles",
    "requestBody": {
      "content": {
        "application/json": {
          "schema": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "additionalProperties": false,
            "description": "What the operation is asked with.",
            "title": "Asked",
            "type": "object"
          }
        }
      },
      "required": true
    },
    "responses": {
      "200": {
        "content": {
          "application/json": {
            "schema": {
              "$defs": {
                "CuratedUnit": {
                  "description": "A unit a curator of music or books is asked for in.",
                  "oneOf": [
                    {
                      "const": "album",
                      "description": "An album.",
                      "type": "string"
                    },
                    {
                      "const": "artist",
                      "description": "An artist.",
                      "type": "string"
                    },
                    {
                      "const": "book",
                      "description": "A book.",
                      "type": "string"
                    },
                    {
                      "const": "author",
                      "description": "An author.",
                      "type": "string"
                    },
                    {
                      "const": "series",
                      "description": "A series of books.",
                      "type": "string"
                    }
                  ]
                },
                "Profile": {
                  "additionalProperties": false,
                  "description": "One profile a request may name.",
                  "properties": {
                    "id": {
                      "description": "The curator's id for it.",
                      "format": "int64",
                      "type": "integer"
                    },
                    "name": {
                      "description": "What it is called.",
                      "type": "string"
                    }
                  },
                  "required": [
                    "id",
                    "name"
                  ],
                  "type": "object"
                }
              },
              "$schema": "https://json-schema.org/draft/2020-12/schema",
              "additionalProperties": false,
              "description": "What a request may be made with.",
              "properties": {
                "metadata": {
                  "description": "Its metadata profiles, which only a curator of music holds.",
                  "items": {
                    "$ref": "#/$defs/Profile"
                  },
                  "type": "array"
                },
                "quality": {
                  "description": "Its quality profiles.",
                  "items": {
                    "$ref": "#/$defs/Profile"
                  },
                  "type": "array"
                },
                "root_folders": {
                  "description": "The root folders it files into.",
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                "units": {
                  "description": "The units of its medium it answers for as it is configured now.",
                  "items": {
                    "$ref": "#/$defs/CuratedUnit"
                  },
                  "type": "array"
                }
              },
              "required": [
                "units",
                "root_folders",
                "quality",
                "metadata"
              ],
              "title": "AskedWith",
              "type": "object"
            }
          }
        },
        "description": "What the operation answers."
      },
      "204": {
        "description": "Answered, with nothing to say."
      },
