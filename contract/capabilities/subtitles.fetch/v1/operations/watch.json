{
  "post": {
    "operationId": "watch",
    "requestBody": {
      "content": {
        "application/json": {
          "schema": {
            "$defs": {
              "Kind": {
                "description": "The two kinds of video a household files by resolution.",
                "oneOf": [
                  {
                    "const": "tv",
                    "description": "Television: series, seasons and episodes.",
                    "type": "string"
                  },
                  {
                    "const": "movies",
                    "description": "Film.",
                    "type": "string"
                  }
                ]
              },
              "Watched": {
                "additionalProperties": false,
                "description": "A curator, as a subtitle finder needs to be told about it.\n\nThe host is a name on the stack's own network rather than an address: the finder\nis a container beside them, so `127.0.0.1` there is the finder itself.",
                "properties": {
                  "api_key": {
                    "description": "The curator's own key, which is what lets the finder read what it has.",
                    "type": "string"
                  },
                  "host": {
                    "description": "The host the finder reaches it on.",
                    "type": "string"
                  },
                  "port": {
                    "description": "The port it listens on.",
                    "format": "uint16",
                    "maximum": 65535,
                    "minimum": 0,
                    "type": "integer"
                  },
                  "which": {
                    "$ref": "#/$defs/Kind",
                    "description": "What it files, selecting the settings it is filed under. Only video carries\nsubtitles, so only a kind of video is ever watched."
                  }
                },
                "required": [
                  "which",
                  "host",
                  "port",
                  "api_key"
                ],
                "type": "object"
              }
            },
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "additionalProperties": false,
            "description": "What the operation is asked with.",
            "properties": {
              "watched": {
                "$ref": "#/$defs/Watched",
                "description": "The port's `watched`."
              }
            },
            "required": [
              "watched"
            ],
            "title": "Asked",
            "type": "object"
          }
        }
      },
      "required": true
    },
    "responses": {
      "200": {
        "content": {
          "application/json": {
            "schema": {
              "$schema": "https://json-schema.org/draft/2020-12/schema",
              "title": "null",
              "type": "null"
            }
          }
        },
        "description": "What the operation answers."
      },
      "204": {
        "description": "Answered, with nothing to say."
      },
      "400": {
        "$ref": "../openapi.json#/components/responses/Refused"
      },
      "401": {
        "description": "The plugin's key was absent or wrong."
      },
      "404": {
        "$ref": "../openapi.json#/components/responses/Refused"
      },
      "500": {
        "$ref": "../openapi.json#/components/responses/Refused"
      },
      "502": {
        "$ref": "../openapi.json#/components/responses/Refused"
      },
      "503": {
        "$ref": "../openapi.json#/components/responses/Refused"
      }
    },
    "security": [
      {
        "key": []
      }
    ]
  }
}
