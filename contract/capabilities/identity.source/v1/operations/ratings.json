{
  "post": {
    "operationId": "ratings",
    "requestBody": {
      "content": {
        "application/json": {
          "schema": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "additionalProperties": false,
            "description": "What the operation is asked with.",
            "title": "Asked",
            "type": "object"
          }
        }
      },
      "required": true
    },
    "responses": {
      "200": {
        "content": {
          "application/json": {
            "schema": {
              "$defs": {
                "Certificate": {
                  "additionalProperties": false,
                  "description": "One certificate the media server's own rating table names.\n\nRead off the server rather than shipped, because the table is regional: the same\nage carries different names in different countries, and half of them carry no\nnumber a person could read off them.\n\nThe server's table also carries an entry for content it has no rating for, and that\nentry carries no age. It is not a certificate and is not one of these — what to do\nabout unrated content is a separate choice, carried separately by [`Allowed`].",
                  "properties": {
                    "age": {
                      "description": "The age the media server holds it against.",
                      "format": "uint32",
                      "minimum": 0,
                      "type": "integer"
                    },
                    "name": {
                      "description": "What the certificate is called where the operator lives.",
                      "type": "string"
                    }
                  },
                  "required": [
                    "name",
                    "age"
                  ],
                  "type": "object"
                }
              },
              "$schema": "https://json-schema.org/draft/2020-12/schema",
              "items": {
                "$ref": "#/$defs/Certificate"
              },
              "title": "Array_of_Certificate",
              "type": "array"
            }
          }
        },
        "description": "What the operation answers."
      },
      "204": {
        "description": "Answered, with nothing to say."
      },
      "400": {
        "$ref": "../openapi.json#/components/responses/Refused"
      },
      "401": {
        "description": "The plugin's key was absent or wrong."
      },
      "404": {
        "$ref": "../openapi.json#/components/responses/Refused"
      },
      "500": {
        "$ref": "../openapi.json#/components/responses/Refused"
      },
      "502": {
        "$ref": "../openapi.json#/components/responses/Refused"
      },
      "503": {
        "$ref": "../openapi.json#/components/responses/Refused"
      }
    },
    "security": [
      {
        "key": []
      }
    ]
  }
}
