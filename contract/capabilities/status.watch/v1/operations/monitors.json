{
  "post": {
    "operationId": "monitors",
    "requestBody": {
      "content": {
        "application/json": {
          "schema": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "additionalProperties": false,
            "description": "What the operation is asked with.",
            "title": "Asked",
            "type": "object"
          }
        }
      },
      "required": true
    },
    "responses": {
      "200": {
        "content": {
          "application/json": {
            "schema": {
              "$defs": {
                "Beat": {
                  "additionalProperties": false,
                  "description": "A heartbeat's interval and grace, and its last check-in.",
                  "properties": {
                    "every_s": {
                      "description": "The seconds between the check-ins it expects.",
                      "format": "uint64",
                      "minimum": 0,
                      "type": "integer"
                    },
                    "grace_s": {
                      "description": "The seconds past its interval it waits before it alarms.",
                      "format": "uint64",
                      "minimum": 0,
                      "type": "integer"
                    },
                    "last_check_in": {
                      "description": "When it last checked in, in seconds since the Unix epoch, or nothing where it never\nhas.",
                      "format": "uint64",
                      "minimum": 0,
                      "type": [
                        "integer",
                        "null"
                      ]
                    }
                  },
                  "required": [
                    "every_s",
                    "grace_s"
                  ],
                  "type": "object"
                },
                "Monitor": {
                  "additionalProperties": false,
                  "description": "One monitor the watcher holds.",
                  "properties": {
                    "active": {
                      "description": "Whether it is checking, rather than only defined.",
                      "type": "boolean"
                    },
                    "heartbeat": {
                      "anyOf": [
                        {
                          "$ref": "#/$defs/Beat"
                        },
                        {
                          "type": "null"
                        }
                      ],
                      "description": "A heartbeat's interval, grace and last check-in."
                    },
                    "id": {
                      "description": "The watcher's id for it.",
                      "type": "string"
                    },
                    "kind": {
                      "$ref": "#/$defs/MonitorKind",
                      "description": "How it checks."
                    },
                    "last_reading": {
                      "description": "When it last took a reading, in seconds since the Unix epoch, or nothing where it\nnever has.",
                      "format": "uint64",
                      "minimum": 0,
                      "type": [
                        "integer",
                        "null"
                      ]
                    },
                    "name": {
                      "description": "Its own name in the watcher.",
                      "type": "string"
                    },
                    "since": {
                      "description": "Since when, in seconds since the Unix epoch.",
                      "format": "uint64",
                      "minimum": 0,
                      "type": "integer"
                    },
                    "state": {
                      "$ref": "#/$defs/MonitorState",
                      "description": "What it last found."
                    },
                    "tag": {
                      "description": "The tag lemonfiber gave it, where lemonfiber made it.",
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "target": {
                      "description": "What it is pointed at.",
                      "type": "string"
                    }
                  },
                  "required": [
                    "id",
                    "name",
                    "kind",
                    "target",
                    "active",
                    "state",
                    "since"
                  ],
                  "type": "object"
                },
                "MonitorKind": {
                  "description": "How a monitor checks what it watches.",
                  "oneOf": [
                    {
                      "const": "http",
                      "description": "An HTTP request answered with a success.",
                      "type": "string"
                    },
                    {
                      "const": "keyword",
                      "description": "An HTTP request whose answer holds a word.",
                      "type": "string"
                    },
                    {
                      "const": "port",
                      "description": "A TCP port that takes a connection.",
                      "type": "string"
                    },
                    {
                      "const": "ping",
                      "description": "A host that answers a ping.",
                      "type": "string"
                    },
                    {
                      "const": "dns",
                      "description": "A name that resolves.",
                      "type": "string"
                    },
                    {
                      "const": "docker",
                      "description": "A container that runs.",
                      "type": "string"
                    },
                    {
                      "const": "heartbeat",
                      "description": "A check-in expected each interval.",
                      "type": "string"
                    }
                  ]
                },
                "MonitorState": {
                  "description": "What a monitor last found.",
                  "oneOf": [
                    {
                      "const": "up",
                      "description": "What it watches answered.",
                      "type": "string"
                    },
                    {
                      "const": "down",
                      "description": "What it watches failed as many checks as it alarms after.",
                      "type": "string"
                    },
                    {
                      "const": "pending",
                      "description": "What it watches failed a check, and fewer than it alarms after.",
                      "type": "string"
                    },
                    {
                      "const": "paused",
                      "description": "It is not checking.",
                      "type": "string"
                    }
                  ]
                }
              },
              "$schema": "https://json-schema.org/draft/2020-12/schema",
              "items": {
                "$ref": "#/$defs/Monitor"
              },
              "title": "Array_of_Monitor",
              "type": "array"
            }
          }
        },
        "description": "What the operation answers."
      },
      "204": {
        "description": "Answered, with nothing to say."
      },
      "400": {
        "$ref": "../openapi.json#/components/responses/Refused"
      },
      "401": {
        "description": "The plugin's key was absent or wrong."
      },
      "404": {
        "$ref": "../openapi.json#/components/responses/Refused"
      },
      "500": {
        "$ref": "../openapi.json#/components/responses/Refused"
      },
      "502": {
        "$ref": "../openapi.json#/components/responses/Refused"
      },
      "503": {
        "$ref": "../openapi.json#/components/responses/Refused"
      }
    },
    "security": [
      {
        "key": []
      }
    ],
    "x-lemonfiber-deadline": 15,
    "x-lemonfiber-largest": 1048576,
    "x-lemonfiber-since": 0
  }
}
