{
  "post": {
    "operationId": "admitted",
    "requestBody": {
      "content": {
        "application/json": {
          "schema": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "additionalProperties": false,
            "description": "What the operation is asked with.",
            "title": "Asked",
            "type": "object"
          }
        }
      },
      "required": true
    },
    "responses": {
      "200": {
        "content": {
          "application/json": {
            "schema": {
              "$defs": {
                "Admitted": {
                  "additionalProperties": false,
                  "description": "One route the gate admits, as it answers it: its credential by fingerprint alone.",
                  "properties": {
                    "address": {
                      "description": "Where the gate reaches it.",
                      "type": "string"
                    },
                    "fingerprint": {
                      "description": "The credential it presents, by its fingerprint: `~` and the low sixteen bits of the 64-bit FNV-1a hash of its bytes, as four lower-case hexadecimal digits.",
                      "type": "string"
                    },
                    "majors": {
                      "description": "The upstream's majors it forwards to.",
                      "items": {
                        "format": "uint32",
                        "minimum": 0,
                        "type": "integer"
                      },
                      "type": "array"
                    },
                    "path": {
                      "description": "The path segment it answers under.",
                      "type": "string"
                    },
                    "target": {
                      "$ref": "#/$defs/Target",
                      "description": "What it reaches."
                    },
                    "tokens": {
                      "description": "The SHA-256 of each token it admits on it, in lower-case hexadecimal.",
                      "items": {
                        "type": "string"
                      },
                      "type": "array"
                    }
                  },
                  "required": [
                    "target",
                    "path",
                    "address",
                    "majors",
                    "fingerprint",
                    "tokens"
                  ],
                  "type": "object"
                },
                "Target": {
                  "description": "What a route reaches.",
                  "oneOf": [
                    {
                      "additionalProperties": false,
                      "description": "A curator.",
                      "properties": {
                        "curator": {
                          "additionalProperties": false,
                          "properties": {
                            "media_type": {
                              "description": "The media type it files.",
                              "type": "string"
                            }
                          },
                          "required": [
                            "media_type"
                          ],
                          "type": "object"
                        }
                      },
                      "required": [
                        "curator"
                      ],
                      "type": "object"
                    },
                    {
                      "const": "media-server",
                      "description": "The media server.",
                      "type": "string"
                    }
                  ]
                }
              },
              "$schema": "https://json-schema.org/draft/2020-12/schema",
              "items": {
                "$ref": "#/$defs/Admitted"
              },
              "title": "Array_of_Admitted",
              "type": "array"
            }
          }
        },
        "description": "What the operation answers."
      },
      "204": {
        "description": "Answered, with nothing to say."
      },
      "400": {
        "$ref": "../openapi.json#/components/responses/Refused"
      },
      "401": {
        "description": "The plugin's key was absent or wrong."
      },
      "404": {
        "$ref": "../openapi.json#/components/responses/Refused"
      },
      "500": {
        "$ref": "../openapi.json#/components/responses/Refused"
      },
      "502": {
        "$ref": "../openapi.json#/components/responses/Refused"
      },
      "503": {
        "$ref": "../openapi.json#/components/responses/Refused"
      }
    },
    "security": [
      {
        "key": []
      }
    ],
    "x-lemonfiber-largest": 1048576
  }
}
