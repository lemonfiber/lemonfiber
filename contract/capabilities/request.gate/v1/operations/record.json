{
  "post": {
    "operationId": "record",
    "requestBody": {
      "content": {
        "application/json": {
          "schema": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "additionalProperties": false,
            "description": "What the operation is asked with.",
            "properties": {
              "after": {
                "description": "The port's `after`.",
                "format": "uint64",
                "minimum": 0,
                "type": "integer"
              }
            },
            "required": [
              "after"
            ],
            "title": "Asked",
            "type": "object"
          }
        }
      },
      "required": true
    },
    "responses": {
      "200": {
        "content": {
          "application/json": {
            "schema": {
              "$defs": {
                "GateEntry": {
                  "additionalProperties": false,
                  "description": "One call the gate recorded: never a token, a query string or a body.",
                  "properties": {
                    "at": {
                      "description": "When, in seconds since the Unix epoch.",
                      "format": "uint64",
                      "minimum": 0,
                      "type": "integer"
                    },
                    "method": {
                      "description": "Its method, as it was sent.",
                      "type": "string"
                    },
                    "outcome": {
                      "$ref": "#/$defs/GateOutcome",
                      "description": "What became of it."
                    },
                    "path": {
                      "description": "Its path, without a query string.",
                      "type": "string"
                    },
                    "route": {
                      "description": "The path segment of the route it was made on.",
                      "type": "string"
                    },
                    "seq": {
                      "description": "Its place in the record, counting from one and never reused.",
                      "format": "uint64",
                      "minimum": 0,
                      "type": "integer"
                    }
                  },
                  "required": [
                    "seq",
                    "at",
                    "route",
                    "method",
                    "path",
                    "outcome"
                  ],
                  "type": "object"
                },
                "GateOutcome": {
                  "description": "What became of one call the gate recorded.",
                  "oneOf": [
                    {
                      "const": "refused",
                      "description": "Refused, and not passed on.",
                      "type": "string"
                    },
                    {
                      "const": "removed",
                      "description": "A removal, passed on.",
                      "type": "string"
                    }
                  ]
                }
              },
              "$schema": "https://json-schema.org/draft/2020-12/schema",
              "additionalProperties": false,
              "description": "What the gate recorded after one entry.",
              "properties": {
                "entries": {
                  "description": "Every entry after it that the gate still holds, oldest first.",
                  "items": {
                    "$ref": "#/$defs/GateEntry"
                  },
                  "type": "array"
                },
                "lost": {
                  "description": "How many entries after it the gate no longer holds.",
                  "format": "uint64",
                  "minimum": 0,
                  "type": "integer"
                }
              },
              "required": [
                "entries",
                "lost"
              ],
              "title": "GateRecord",
              "type": "object"
            }
          }
        },
        "description": "What the operation answers."
      },
      "204": {
        "description": "Answered, with nothing to say."
      },
      "400": {
        "$ref": "../openapi.json#/components/responses/Refused"
      },
      "401": {
        "description": "The plugin's key was absent or wrong."
      },
      "404": {
        "$ref": "../openapi.json#/components/responses/Refused"
      },
      "500": {
        "$ref": "../openapi.json#/components/responses/Refused"
      },
      "502": {
        "$ref": "../openapi.json#/components/responses/Refused"
      },
      "503": {
        "$ref": "../openapi.json#/components/responses/Refused"
      }
    },
    "security": [
      {
        "key": []
      }
    ],
    "x-lemonfiber-deadline": 15,
    "x-lemonfiber-largest": 1048576
  }
}
