{
  "post": {
    "operationId": "admit",
    "requestBody": {
      "content": {
        "application/json": {
          "schema": {
            "$defs": {
              "Gated": {
                "additionalProperties": false,
                "description": "One route the gate admits, as it is applied.",
                "properties": {
                  "address": {
                    "description": "Where the gate reaches it.",
                    "type": "string"
                  },
                  "credential": {
                    "description": "The credential the gate presents to it.",
                    "type": "string"
                  },
                  "majors": {
                    "description": "The upstream's majors the stack supports, the only ones the gate forwards to; none\nwhere the gate knows the upstream's one supported interface itself.",
                    "items": {
                      "format": "uint32",
                      "minimum": 0,
                      "type": "integer"
                    },
                    "type": "array"
                  },
                  "path": {
                    "description": "The path segment it answers under.",
                    "type": "string"
                  },
                  "target": {
                    "$ref": "#/$defs/Target",
                    "description": "What it reaches."
                  },
                  "tokens": {
                    "description": "The SHA-256 of each token the gate admits on it, in lower-case hexadecimal.",
                    "items": {
                      "type": "string"
                    },
                    "type": "array"
                  }
                },
                "required": [
                  "target",
                  "path",
                  "address",
                  "majors",
                  "credential",
                  "tokens"
                ],
                "type": "object"
              },
              "OutsideAccount": {
                "additionalProperties": false,
                "description": "An account as the outside service that holds the media server's accounts knows it, as\nplex.tv knows a Plex account, and never its token.",
                "properties": {
                  "id": {
                    "description": "The id the outside service holds it by, in decimal digits.",
                    "type": "string"
                  },
                  "title": {
                    "description": "The name it is shown under.",
                    "type": "string"
                  },
                  "username": {
                    "description": "The name it signs in under.",
                    "type": "string"
                  },
                  "uuid": {
                    "description": "Its uuid at the outside service.",
                    "type": "string"
                  }
                },
                "required": [
                  "id",
                  "uuid",
                  "username",
                  "title"
                ],
                "type": "object"
              },
              "OutsideServer": {
                "additionalProperties": false,
                "description": "The media server as the outside service that holds its accounts lists it, as plex.tv\nlists a Plex server.",
                "properties": {
                  "id": {
                    "description": "The identifier the outside service and the server hold it by: on Plex, its machine\nidentifier.",
                    "type": "string"
                  },
                  "name": {
                    "description": "The name it is listed under.",
                    "type": "string"
                  }
                },
                "required": [
                  "name",
                  "id"
                ],
                "type": "object"
              },
              "PlexLink": {
                "description": "How the request service is linked to Plex, as `PLEX_LINK_MODE` names it.",
                "oneOf": [
                  {
                    "additionalProperties": false,
                    "description": "Its owner is its own managed account, whose token is the one the route admits.",
                    "properties": {
                      "mode": {
                        "const": "managed",
                        "type": "string"
                      }
                    },
                    "required": [
                      "mode"
                    ],
                    "type": "object"
                  },
                  {
                    "additionalProperties": false,
                    "description": "Its owner is the operator's own Plex account, signed in on its own page.",
                    "properties": {
                      "account": {
                        "description": "The plex.tv account id of the account that claimed Plex: the gate admits a\ntoken plex.tv answers as it.",
                        "type": "string"
                      },
                      "mode": {
                        "const": "owner",
                        "type": "string"
                      }
                    },
                    "required": [
                      "mode",
                      "account"
                    ],
                    "type": "object"
                  },
                  {
                    "additionalProperties": false,
                    "description": "Its owner is its own managed account, holding a gate token, and its plex.tv calls\nreach the gate.",
                    "properties": {
                      "account": {
                        "$ref": "#/$defs/OutsideAccount",
                        "description": "The request service's own account, as plex.tv knows it."
                      },
                      "members": {
                        "description": "The household's Plex accounts with this server's libraries shared with them.",
                        "items": {
                          "$ref": "#/$defs/PlexMember"
                        },
                        "type": "array"
                      },
                      "mode": {
                        "const": "fronted",
                        "type": "string"
                      },
                      "server": {
                        "$ref": "#/$defs/OutsideServer",
                        "description": "This server, as plex.tv lists it."
                      }
                    },
                    "required": [
                      "mode",
                      "account",
                      "members",
                      "server"
                    ],
                    "type": "object"
                  }
                ]
              },
              "PlexMember": {
                "additionalProperties": false,
                "description": "A member of the household with this server's libraries shared with them, as the gate\nanswers plex.tv's users for the request service.",
                "properties": {
                  "id": {
                    "description": "The id plex.tv holds their account by.",
                    "type": "string"
                  },
                  "name": {
                    "description": "The name their account goes by.",
                    "type": "string"
                  }
                },
                "required": [
                  "id",
                  "name"
                ],
                "type": "object"
              },
              "Target": {
                "description": "What a route reaches.",
                "oneOf": [
                  {
                    "additionalProperties": false,
                    "description": "A curator.",
                    "properties": {
                      "curator": {
                        "additionalProperties": false,
                        "properties": {
                          "media_type": {
                            "description": "The media type it files.",
                            "type": "string"
                          }
                        },
                        "required": [
                          "media_type"
                        ],
                        "type": "object"
                      }
                    },
                    "required": [
                      "curator"
                    ],
                    "type": "object"
                  },
                  {
                    "additionalProperties": false,
                    "description": "The media server, reached at its internal TLS port.",
                    "properties": {
                      "media-server": {
                        "additionalProperties": false,
                        "properties": {
                          "pins": {
                            "description": "The SHA-256 of each certificate that port may present, in lower-case\nhexadecimal: the only ones the gate accepts.",
                            "items": {
                              "type": "string"
                            },
                            "type": "array"
                          }
                        },
                        "required": [
                          "pins"
                        ],
                        "type": "object"
                      }
                    },
                    "required": [
                      "media-server"
                    ],
                    "type": "object"
                  },
                  {
                    "additionalProperties": false,
                    "description": "Plex as the media server, answered in its own API at [`PLEX_PORT`] with no path\nsegment, and reached at its internal TLS port.",
                    "properties": {
                      "plex": {
                        "additionalProperties": false,
                        "properties": {
                          "link": {
                            "$ref": "#/$defs/PlexLink",
                            "description": "How the request service is linked to Plex, which says what the gate admits on\nthe route and what it answers for plex.tv."
                          },
                          "pins": {
                            "description": "The SHA-256 of each certificate that port may present, in lower-case\nhexadecimal: the only ones the gate accepts.",
                            "items": {
                              "type": "string"
                            },
                            "type": "array"
                          }
                        },
                        "required": [
                          "pins",
                          "link"
                        ],
                        "type": "object"
                      }
                    },
                    "required": [
                      "plex"
                    ],
                    "type": "object"
                  }
                ]
              }
            },
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "additionalProperties": false,
            "description": "What the operation is asked with.",
            "properties": {
              "routes": {
                "description": "The port's `routes`.",
                "items": {
                  "$ref": "#/$defs/Gated"
                },
                "type": "array"
              }
            },
            "required": [
              "routes"
            ],
            "title": "Asked",
            "type": "object"
          }
        }
      },
      "required": true
    },
    "responses": {
      "200": {
        "content": {
          "application/json": {
            "schema": {
              "$schema": "https://json-schema.org/draft/2020-12/schema",
              "title": "null",
              "type": "null"
            }
          }
        },
        "description": "What the operation answers."
      },
      "204": {
        "description": "Answered, with nothing to say."
      },
      "400": {
        "$ref": "../openapi.json#/components/responses/Refused"
      },
      "401": {
        "description": "The plugin's key was absent or wrong."
      },
      "404": {
        "$ref": "../openapi.json#/components/responses/Refused"
      },
      "500": {
        "$ref": "../openapi.json#/components/responses/Refused"
      },
      "502": {
        "$ref": "../openapi.json#/components/responses/Refused"
      },
      "503": {
        "$ref": "../openapi.json#/components/responses/Refused"
      }
    },
    "security": [
      {
        "key": []
      }
    ],
    "x-lemonfiber-deadline": 15,
    "x-lemonfiber-largest": 1048576,
    "x-lemonfiber-since": 0
  }
}
