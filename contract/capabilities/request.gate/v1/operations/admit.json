{
  "post": {
    "operationId": "admit",
    "requestBody": {
      "content": {
        "application/json": {
          "schema": {
            "$defs": {
              "Gated": {
                "additionalProperties": false,
                "description": "One route the gate admits, as it is applied.",
                "properties": {
                  "address": {
                    "description": "Where the gate reaches it.",
                    "type": "string"
                  },
                  "credential": {
                    "description": "The credential the gate presents to it.",
                    "type": "string"
                  },
                  "majors": {
                    "description": "The upstream's majors the stack supports, the only ones the gate forwards to; none\nwhere the gate knows the upstream's one supported interface itself.",
                    "items": {
                      "format": "uint32",
                      "minimum": 0,
                      "type": "integer"
                    },
                    "type": "array"
                  },
                  "path": {
                    "description": "The path segment it answers under.",
                    "type": "string"
                  },
                  "target": {
                    "$ref": "#/$defs/Target",
                    "description": "What it reaches."
                  },
                  "tokens": {
                    "description": "The SHA-256 of each token the gate admits on it, in lower-case hexadecimal.",
                    "items": {
                      "type": "string"
                    },
                    "type": "array"
                  }
                },
                "required": [
                  "target",
                  "path",
                  "address",
                  "majors",
                  "credential",
                  "tokens"
                ],
                "type": "object"
              },
              "Target": {
                "description": "What a route reaches.",
                "oneOf": [
                  {
                    "additionalProperties": false,
                    "description": "A curator.",
                    "properties": {
                      "curator": {
                        "additionalProperties": false,
                        "properties": {
                          "media_type": {
                            "description": "The media type it files.",
                            "type": "string"
                          }
                        },
                        "required": [
                          "media_type"
                        ],
                        "type": "object"
                      }
                    },
                    "required": [
                      "curator"
                    ],
                    "type": "object"
                  },
                  {
                    "additionalProperties": false,
                    "description": "The media server, reached at its internal TLS port.",
                    "properties": {
                      "media-server": {
                        "additionalProperties": false,
                        "properties": {
                          "pins": {
                            "description": "The SHA-256 of each certificate that port may present, in lower-case\nhexadecimal: the only ones the gate accepts.",
                            "items": {
                              "type": "string"
                            },
                            "type": "array"
                          }
                        },
                        "required": [
                          "pins"
                        ],
                        "type": "object"
                      }
                    },
                    "required": [
                      "media-server"
                    ],
                    "type": "object"
                  }
                ]
              }
            },
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "additionalProperties": false,
            "description": "What the operation is asked with.",
            "properties": {
              "routes": {
                "description": "The port's `routes`.",
                "items": {
                  "$ref": "#/$defs/Gated"
                },
                "type": "array"
              }
            },
            "required": [
              "routes"
            ],
            "title": "Asked",
            "type": "object"
          }
        }
      },
      "required": true
    },
    "responses": {
      "200": {
        "content": {
          "application/json": {
            "schema": {
              "$schema": "https://json-schema.org/draft/2020-12/schema",
              "title": "null",
              "type": "null"
            }
          }
        },
        "description": "What the operation answers."
      },
      "204": {
        "description": "Answered, with nothing to say."
      },
      "400": {
        "$ref": "../openapi.json#/components/responses/Refused"
      },
      "401": {
        "description": "The plugin's key was absent or wrong."
      },
      "404": {
        "$ref": "../openapi.json#/components/responses/Refused"
      },
      "500": {
        "$ref": "../openapi.json#/components/responses/Refused"
      },
      "502": {
        "$ref": "../openapi.json#/components/responses/Refused"
      },
      "503": {
        "$ref": "../openapi.json#/components/responses/Refused"
      }
    },
    "security": [
      {
        "key": []
      }
    ],
    "x-lemonfiber-largest": 1048576
  }
}
