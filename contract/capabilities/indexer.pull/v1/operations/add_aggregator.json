{
  "post": {
    "operationId": "add_aggregator",
    "requestBody": {
      "content": {
        "application/json": {
          "schema": {
            "$defs": {
              "AggregatorAt": {
                "additionalProperties": false,
                "description": "An aggregator a curator pulls its indexers from, reached in its own native API.",
                "properties": {
                  "key": {
                    "description": "The aggregator's own key, which is what lets the list be read at all.",
                    "type": "string"
                  },
                  "name": {
                    "description": "What it is called where somebody reads the list.",
                    "type": "string"
                  },
                  "protocol": {
                    "$ref": "#/$defs/Protocol",
                    "description": "Its native API, so a curator is never handed an aggregator it cannot read."
                  },
                  "url": {
                    "description": "Where it is reached, on the stack's own network.",
                    "type": "string"
                  }
                },
                "required": [
                  "name",
                  "url",
                  "protocol",
                  "key"
                ],
                "type": "object"
              },
              "Protocol": {
                "description": "The protocol a download client is reached in: the name of the API a curator speaks\nto it, as the download client declares it.",
                "type": "string"
              }
            },
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "additionalProperties": false,
            "description": "What the operation is asked with.",
            "properties": {
              "aggregator": {
                "$ref": "#/$defs/AggregatorAt",
                "description": "The port's `aggregator`."
              }
            },
            "required": [
              "aggregator"
            ],
            "title": "Asked",
            "type": "object"
          }
        }
      },
      "required": true
    },
    "responses": {
      "200": {
        "content": {
          "application/json": {
            "schema": {
              "$schema": "https://json-schema.org/draft/2020-12/schema",
              "title": "null",
              "type": "null"
            }
          }
        },
        "description": "What the operation answers."
      },
      "204": {
        "description": "Answered, with nothing to say."
      },
      "400": {
        "$ref": "../openapi.json#/components/responses/Refused"
      },
      "401": {
