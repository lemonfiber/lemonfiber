{
  "post": {
    "operationId": "ask",
    "requestBody": {
      "content": {
        "application/json": {
          "schema": {
            "$defs": {
              "Kind": {
                "description": "The two kinds of video a household files by resolution.",
                "oneOf": [
                  {
                    "const": "tv",
                    "description": "Television: series, seasons and episodes.",
                    "type": "string"
                  },
                  {
                    "const": "movies",
                    "description": "Film.",
                    "type": "string"
                  }
                ]
              },
              "Wish": {
                "additionalProperties": false,
                "description": "What a member asks for: one title, and for a series the seasons of it.",
                "properties": {
                  "id": {
                    "description": "The id the request service knows the title by.",
                    "type": "string"
                  },
                  "kind": {
                    "$ref": "#/$defs/Kind",
                    "description": "Whether it is a series or a film."
                  },
                  "seasons": {
                    "description": "The seasons asked for, and every season where none are named.",
                    "items": {
                      "format": "uint32",
                      "minimum": 0,
                      "type": "integer"
                    },
                    "type": "array"
                  }
                },
                "required": [
                  "id",
                  "kind",
                  "seasons"
                ],
                "type": "object"
              }
            },
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "additionalProperties": false,
            "description": "What the operation is asked with.",
            "properties": {
              "member": {
                "description": "The port's `member`.",
                "type": "string"
              },
              "wish": {
                "$ref": "#/$defs/Wish",
                "description": "The port's `wish`."
              }
            },
            "required": [
              "member",
              "wish"
            ],
            "title": "Asked",
            "type": "object"
          }
        }
      },
      "required": true
    },
    "responses": {
      "200": {
        "content": {
          "application/json": {
            "schema": {
              "$schema": "https://json-schema.org/draft/2020-12/schema",
              "additionalProperties": false,
              "description": "What became of an ask.",
              "properties": {
                "request": {
                  "description": "The number the request service files the request under.",
                  "format": "int64",
                  "type": "integer"
                },
                "waiting": {
                  "description": "Whether it waits for somebody to approve it.",
                  "type": "boolean"
                }
              },
              "required": [
                "request",
                "waiting"
              ],
              "title": "Asked",
              "type": "object"
            }
          }
        },
        "description": "What the operation answers."
      },
      "204": {
        "description": "Answered, with nothing to say."
      },
      "400": {
        "$ref": "../openapi.json#/components/responses/Refused"
      },
      "401": {
        "description": "The plugin's key was absent or wrong."
      },
      "404": {
        "$ref": "../openapi.json#/components/responses/Refused"
      },
      "500": {
        "$ref": "../openapi.json#/components/responses/Refused"
      },
      "502": {
        "$ref": "../openapi.json#/components/responses/Refused"
      },
      "503": {
        "$ref": "../openapi.json#/components/responses/Refused"
      }
    },
    "security": [
      {
        "key": []
      }
    ],
    "x-lemonfiber-largest": 1048576
  }
}
