{
  "post": {
    "operationId": "fulfilment_targets",
    "requestBody": {
      "content": {
        "application/json": {
          "schema": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "additionalProperties": false,
            "description": "What the operation is asked with.",
            "title": "Asked",
            "type": "object"
          }
        }
      },
      "required": true
    },
    "responses": {
      "200": {
        "content": {
          "application/json": {
            "schema": {
              "$defs": {
                "Endpoint": {
                  "additionalProperties": false,
                  "description": "Where the request service reaches a curator: a host, a port, and the path it answers\nunder there.",
                  "properties": {
                    "base": {
                      "description": "The path the curator answers under at that host: empty where it answers at the\nroot, and a route of its own where something in front of it answers for\nseveral.",
                      "type": "string"
                    },
                    "host": {
                      "description": "The host.",
                      "type": "string"
                    },
                    "port": {
                      "description": "The port.",
                      "format": "uint16",
                      "maximum": 65535,
                      "minimum": 0,
                      "type": "integer"
                    }
                  },
                  "required": [
                    "host",
                    "port",
                    "base"
                  ],
                  "type": "object"
                },
                "Kind": {
                  "description": "The two kinds of video a household files by resolution.",
                  "oneOf": [
                    {
                      "const": "tv",
                      "description": "Television: series, seasons and episodes.",
                      "type": "string"
                    },
                    {
                      "const": "movies",
                      "description": "Film.",
                      "type": "string"
                    }
                  ]
                },
                "RegisteredTarget": {
                  "additionalProperties": false,
                  "description": "A curator the request service already holds, with the identifier it gave it.\n\nRead back so one already registered can be told from an absent one — matched by\nthe endpoint it reaches rather than by its label, the way a download client is,\nso an operator who renamed it is not handed a duplicate.",
                  "properties": {
                    "at": {
                      "$ref": "#/$defs/Endpoint",
                      "description": "Where it is reached."
                    },
                    "id": {
                      "description": "The identifier the request service assigned.",
                      "type": "string"
                    },
                    "key": {
                      "description": "The key the request service presents there.",
                      "type": "string"
                    },
                    "kind": {
                      "$ref": "#/$defs/Kind",
                      "description": "The kind of video the list it is in fetches."
                    }
                  },
                  "required": [
                    "id",
                    "at",
                    "key",
                    "kind"
                  ],
                  "type": "object"
                }
              },
              "$schema": "https://json-schema.org/draft/2020-12/schema",
              "items": {
                "$ref": "#/$defs/RegisteredTarget"
              },
              "title": "Array_of_RegisteredTarget",
              "type": "array"
            }
          }
        },
        "description": "What the operation answers."
      },
      "204": {
        "description": "Answered, with nothing to say."
      },
      "400": {
        "$ref": "../openapi.json#/components/responses/Refused"
      },
      "401": {
        "description": "The plugin's key was absent or wrong."
      },
      "404": {
        "$ref": "../openapi.json#/components/responses/Refused"
      },
      "500": {
        "$ref": "../openapi.json#/components/responses/Refused"
      },
      "502": {
        "$ref": "../openapi.json#/components/responses/Refused"
      },
      "503": {
        "$ref": "../openapi.json#/components/responses/Refused"
      }
    },
    "security": [
      {
        "key": []
      }
    ],
    "x-lemonfiber-largest": 1048576
  }
}
