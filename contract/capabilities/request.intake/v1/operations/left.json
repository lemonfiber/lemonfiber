{
  "post": {
    "operationId": "left",
    "requestBody": {
      "content": {
        "application/json": {
          "schema": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "additionalProperties": false,
            "description": "What the operation is asked with.",
            "properties": {
              "id": {
                "description": "The port's `id`.",
                "type": "string"
              }
            },
            "required": [
              "id"
            ],
            "title": "Asked",
            "type": "object"
          }
        }
      },
      "required": true
    },
    "responses": {
      "200": {
        "content": {
          "application/json": {
            "schema": {
              "$defs": {
                "Left": {
                  "additionalProperties": false,
                  "description": "What one kind of request has cost a member, and what the period still allows.\n\nThe limit is absent where nothing holds them to one, which is a different answer\nfrom a limit of nought: nought would be a member who may ask for nothing, and the\nservice spells \"no limit\" that way. Read back rather than derived, so what is\nreported is the arithmetic that will actually refuse the next request.",
                  "properties": {
                    "days": {
                      "description": "How long the period is, in days. `None` where the count runs from the\nbeginning rather than over a window.",
                      "format": "uint32",
                      "minimum": 0,
                      "type": [
                        "integer",
                        "null"
                      ]
                    },
                    "limit": {
                      "description": "How many the period allows. `None` where nothing limits them.",
                      "format": "uint32",
                      "minimum": 0,
                      "type": [
                        "integer",
                        "null"
                      ]
                    },
                    "used": {
                      "description": "How many the period has already counted.",
                      "format": "uint32",
                      "minimum": 0,
                      "type": "integer"
                    }
                  },
                  "required": [
                    "used"
                  ],
                  "type": "object"
                }
              },
              "$schema": "https://json-schema.org/draft/2020-12/schema",
              "additionalProperties": false,
              "description": "What one member has left, in each of the two kinds the service counts.",
              "properties": {
                "films": {
                  "$ref": "#/$defs/Left",
                  "description": "Films, counted one to a request."
                },
                "television": {
                  "$ref": "#/$defs/Left",
                  "description": "Television, counted one to a season — so one ask for a six-season series\nspends six."
                }
              },
              "required": [
                "films",
                "television"
              ],
              "title": "Headroom",
              "type": "object"
            }
          }
        },
        "description": "What the operation answers."
      },
      "204": {
        "description": "Answered, with nothing to say."
      },
      "400": {
        "$ref": "../openapi.json#/components/responses/Refused"
      },
      "401": {
        "description": "The plugin's key was absent or wrong."
      },
      "404": {
        "$ref": "../openapi.json#/components/responses/Refused"
      },
      "500": {
        "$ref": "../openapi.json#/components/responses/Refused"
      },
      "502": {
        "$ref": "../openapi.json#/components/responses/Refused"
      },
      "503": {
        "$ref": "../openapi.json#/components/responses/Refused"
      }
    },
    "security": [
      {
        "key": []
      }
    ]
  }
}
