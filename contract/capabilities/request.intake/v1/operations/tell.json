{
  "post": {
    "operationId": "tell",
    "requestBody": {
      "content": {
        "application/json": {
          "schema": {
            "$defs": {
              "Occasion": {
                "description": "One occasion the request service tells the household about.",
                "oneOf": [
                  {
                    "const": "received",
                    "description": "A request was received and waits on somebody.",
                    "type": "string"
                  },
                  {
                    "const": "approved",
                    "description": "A request was approved.",
                    "type": "string"
                  },
                  {
                    "const": "arrived",
                    "description": "What was asked for arrived.",
                    "type": "string"
                  },
                  {
                    "const": "failed",
                    "description": "What was asked for could not be got.",
                    "type": "string"
                  },
                  {
                    "const": "declined",
                    "description": "A request was turned down.",
                    "type": "string"
                  },
                  {
                    "const": "approved-by-policy",
                    "description": "A request was approved by the household's own policy, with nobody asked.",
                    "type": "string"
                  }
                ]
              },
              "Telling": {
                "additionalProperties": false,
                "description": "Whether the request service reaches the household, and about what.",
                "properties": {
                  "enabled": {
                    "description": "Whether it will send anything at all.",
                    "type": "boolean"
                  },
                  "occasions": {
                    "description": "Which occasions it sends on.",
                    "items": {
                      "$ref": "#/$defs/Occasion"
                    },
                    "type": "array",
                    "uniqueItems": true
                  },
                  "others": {
                    "description": "Whether it also sends on occasions this contract does not name.",
                    "type": "boolean"
                  }
                },
                "required": [
                  "enabled",
                  "occasions",
                  "others"
                ],
                "type": "object"
              }
            },
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "additionalProperties": false,
            "description": "What the operation is asked with.",
            "properties": {
              "telling": {
                "$ref": "#/$defs/Telling",
                "description": "The port's `telling`."
              }
            },
            "required": [
              "telling"
            ],
            "title": "Asked",
            "type": "object"
          }
        }
      },
      "required": true
    },
    "responses": {
      "200": {
        "content": {
          "application/json": {
            "schema": {
              "$schema": "https://json-schema.org/draft/2020-12/schema",
              "title": "null",
              "type": "null"
            }
          }
        },
        "description": "What the operation answers."
      },
      "204": {
        "description": "Answered, with nothing to say."
      },
      "400": {
        "$ref": "../openapi.json#/components/responses/Refused"
      },
      "401": {
        "description": "The plugin's key was absent or wrong."
      },
      "404": {
        "$ref": "../openapi.json#/components/responses/Refused"
      },
      "500": {
        "$ref": "../openapi.json#/components/responses/Refused"
      },
      "502": {
        "$ref": "../openapi.json#/components/responses/Refused"
      },
      "503": {
        "$ref": "../openapi.json#/components/responses/Refused"
      }
    },
    "security": [
      {
        "key": []
      }
    ]
  }
}
