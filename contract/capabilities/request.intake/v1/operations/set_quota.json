  "post": {
    "operationId": "set_quota",
    "requestBody": {
      "content": {
        "application/json": {
          "schema": {
            "$defs": {
              "Quota": {
                "additionalProperties": false,
                "description": "How much may be asked for in a period.\n\nTwo numbers and no more: how many, and over how long. Expressed in the terms a\nhousehold says them in rather than in an internal counter — \"five a week\" is the\nsentence, and both halves of it are here.",
                "properties": {
                  "days": {
                    "description": "How long the period is, in days.",
                    "format": "uint32",
                    "minimum": 0,
                    "type": "integer"
                  },
                  "requests": {
                    "description": "How many requests the period allows.",
                    "format": "uint32",
                    "minimum": 0,
                    "type": "integer"
                  }
                },
                "required": [
                  "requests",
                  "days"
                ],
                "type": "object"
              }
            },
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "additionalProperties": false,
            "description": "What the operation is asked with.",
            "properties": {
              "id": {
                "description": "The port's `id`.",
                "type": "string"
              },
              "quota": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/Quota"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "The port's `quota`."
              }
            },
            "required": [
              "id"
            ],
            "title": "Asked",
            "type": "object"
          }
        }
      },
      "required": true
    },
