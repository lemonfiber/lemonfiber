              "$defs": {
                "Requesting": {
                  "additionalProperties": false,
                  "description": "What one member may ask for on the request service.\n\nOnly the half that bears on what a household chose. Everything else about the\naccount — what they are called, what they may watch — is the media server's to say,\nand a second copy here would be a copy able to disagree with it.",
                  "properties": {
                    "approves_own": {
                      "description": "Whether what they ask for arrives without anybody approving it.\n\nTrue is the state a restriction has to undo: it is the whole of how a limit on\nwatching and a lack of limit on requesting come apart.",
                      "type": "boolean"
                    },
                    "id": {
                      "description": "The identifier this service tells them apart by.",
                      "type": "string"
                    }
                  },
                  "required": [
                    "id",
                    "approves_own"
                  ],
                  "type": "object"
                }
              },
