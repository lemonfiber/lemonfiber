{
  "post": {
    "operationId": "configure_identity",
    "requestBody": {
      "content": {
        "application/json": {
          "schema": {
            "$defs": {
              "Credential": {
                "description": "How a service proves itself: a single API key, or a username and its password.",
                "oneOf": [
                  {
                    "additionalProperties": false,
                    "description": "A single API key.",
                    "properties": {
                      "api-key": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "api-key"
                    ],
                    "type": "object"
                  },
                  {
                    "additionalProperties": false,
                    "description": "A username and its password.",
                    "properties": {
                      "user-pass": {
                        "properties": {
                          "password": {
                            "description": "Its password.",
                            "type": "string"
                          },
                          "username": {
                            "description": "The account name.",
                            "type": "string"
                          }
                        },
                        "required": [
                          "username",
                          "password"
                        ],
                        "type": "object"
                      }
                    },
                    "required": [
                      "user-pass"
                    ],
                    "type": "object"
                  }
                ]
              },
              "IdentitySource": {
                "additionalProperties": false,
                "description": "The identity source a request service signs the household in through: where it is,\nthe protocol it is spoken to in, and the credential that administers it.",
                "properties": {
                  "at": {
                    "description": "Where the request service reaches it.",
                    "type": "string"
                  },
                  "credential": {
                    "$ref": "#/$defs/Credential",
                    "description": "The credential that administers it."
                  },
                  "protocol": {
                    "$ref": "#/$defs/Protocol",
                    "description": "The protocol it is spoken to in."
                  }
                },
                "required": [
                  "at",
                  "protocol",
                  "credential"
                ],
                "type": "object"
              },
              "Protocol": {
                "description": "The protocol a download client is reached in: the name of the API a curator speaks\nto it, as the download client declares it.",
                "type": "string"
              }
            },
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "additionalProperties": false,
            "description": "What the operation is asked with.",
            "properties": {
              "source": {
                "$ref": "#/$defs/IdentitySource",
                "description": "The port's `source`."
              }
            },
            "required": [
              "source"
            ],
            "title": "Asked",
            "type": "object"
          }
        }
      },
      "required": true
    },
    "responses": {
      "200": {
        "content": {
          "application/json": {
            "schema": {
              "$schema": "https://json-schema.org/draft/2020-12/schema",
              "title": "null",
              "type": "null"
            }
          }
        },
        "description": "What the operation answers."
      },
      "204": {
        "description": "Answered, with nothing to say."
      },
      "400": {
        "$ref": "../openapi.json#/components/responses/Refused"
      },
      "401": {
        "description": "The plugin's key was absent or wrong."
      },
      "404": {
        "$ref": "../openapi.json#/components/responses/Refused"
      },
      "500": {
        "$ref": "../openapi.json#/components/responses/Refused"
      },
      "502": {
        "$ref": "../openapi.json#/components/responses/Refused"
      },
      "503": {
        "$ref": "../openapi.json#/components/responses/Refused"
      }
    },
    "security": [
      {
        "key": []
      }
    ]
  }
}
