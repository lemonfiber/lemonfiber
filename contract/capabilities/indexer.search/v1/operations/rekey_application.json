{
  "post": {
    "operationId": "rekey_application",
    "requestBody": {
      "content": {
        "application/json": {
          "schema": {
            "$defs": {
              "RegisteredApplication": {
                "additionalProperties": false,
                "description": "An application the indexer manager already holds, with the identifier it gave it.\n\nRead back so an application already registered can be told from an absent one\n— matched by the address it reaches, the `base_url`, rather than by its label,\nso a differently-named but equivalent application is not duplicated — and so a\nlater undo names exactly the one created.",
                "properties": {
                  "base_url": {
                    "description": "The address it reaches the curator on.",
                    "type": "string"
                  },
                  "id": {
                    "description": "The identifier the indexer manager assigned.",
                    "type": "string"
                  }
                },
                "required": [
                  "id",
                  "base_url"
                ],
                "type": "object"
              }
            },
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "additionalProperties": false,
            "description": "What the operation is asked with.",
            "properties": {
              "held": {
                "$ref": "#/$defs/RegisteredApplication",
                "description": "The port's `held`."
              },
              "key": {
                "description": "The port's `key`.",
                "type": "string"
              }
            },
            "required": [
              "held",
              "key"
            ],
            "title": "Asked",
            "type": "object"
          }
        }
      },
      "required": true
    },
    "responses": {
      "200": {
        "content": {
          "application/json": {
            "schema": {
              "$schema": "https://json-schema.org/draft/2020-12/schema",
              "title": "null",
              "type": "null"
            }
          }
        },
        "description": "What the operation answers."
      },
      "204": {
        "description": "Answered, with nothing to say."
      },
      "400": {
        "$ref": "../openapi.json#/components/responses/Refused"
      },
      "401": {
        "description": "The plugin's key was absent or wrong."
      },
      "404": {
        "$ref": "../openapi.json#/components/responses/Refused"
      },
      "500": {
        "$ref": "../openapi.json#/components/responses/Refused"
      },
      "502": {
        "$ref": "../openapi.json#/components/responses/Refused"
      },
      "503": {
        "$ref": "../openapi.json#/components/responses/Refused"
      }
    },
    "security": [
      {
        "key": []
      }
    ],
    "x-lemonfiber-largest": 1048576
  }
}
