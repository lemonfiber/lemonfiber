{
  "post": {
    "operationId": "applications",
    "requestBody": {
      "content": {
        "application/json": {
          "schema": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "additionalProperties": false,
            "description": "What the operation is asked with.",
            "title": "Asked",
            "type": "object"
          }
        }
      },
      "required": true
    },
    "responses": {
      "200": {
        "content": {
          "application/json": {
            "schema": {
              "$defs": {
                "RegisteredApplication": {
                  "additionalProperties": false,
                  "description": "An application Prowlarr already holds, with the identifier it gave it.\n\nRead back so an application already registered can be told from an absent one\n— matched by the address it reaches, the `base_url`, rather than by its label,\nso a differently-named but equivalent application is not duplicated — and so a\nlater undo names exactly the one created.",
                  "properties": {
                    "base_url": {
                      "description": "The address it reaches the \\*arr on.",
                      "type": "string"
                    },
                    "id": {
                      "description": "The identifier Prowlarr assigned.",
                      "type": "string"
                    }
                  },
                  "required": [
                    "id",
                    "base_url"
                  ],
                  "type": "object"
                }
              },
              "$schema": "https://json-schema.org/draft/2020-12/schema",
              "items": {
                "$ref": "#/$defs/RegisteredApplication"
              },
              "title": "Array_of_RegisteredApplication",
              "type": "array"
            }
          }
        },
        "description": "What the operation answers."
      },
      "204": {
        "description": "Answered, with nothing to say."
      },
      "400": {
        "$ref": "../openapi.json#/components/responses/Refused"
      },
      "401": {
        "description": "The plugin's key was absent or wrong."
      },
      "404": {
        "$ref": "../openapi.json#/components/responses/Refused"
      },
      "500": {
        "$ref": "../openapi.json#/components/responses/Refused"
      },
      "502": {
        "$ref": "../openapi.json#/components/responses/Refused"
      },
      "503": {
        "$ref": "../openapi.json#/components/responses/Refused"
      }
    },
    "security": [
      {
        "key": []
      }
    ]
  }
}
