                  },
                  "name": {
                    "description": "What it is called where somebody reads the list.",
                    "type": "string"
                  },
                  "url": {
                    "description": "Where it is reached — a name on the stack's own network, since the service\ndoing the reading is a container beside it.",
                    "type": "string"
                  }
                },
                "required": [
                  "name",
                  "url",
                  "key"
                ],
                "type": "object"
              }
            },
