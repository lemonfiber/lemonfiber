{
  "post": {
    "operationId": "holdings",
    "requestBody": {
      "content": {
        "application/json": {
          "schema": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "additionalProperties": false,
            "description": "What the operation is asked with.",
            "properties": {
              "member": {
                "description": "The port's `member`.",
                "type": [
                  "string",
                  "null"
                ]
              },
              "most": {
                "description": "The port's `most`.",
