{
  "post": {
    "operationId": "guide",
    "requestBody": {
      "content": {
        "application/json": {
          "schema": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "additionalProperties": false,
            "description": "What the operation is asked with.",
            "properties": {
              "hours": {
                "description": "The port's `hours`.",
                "format": "uint32",
                "minimum": 0,
                "type": "integer"
              },
              "member": {
                "description": "The port's `member`.",
                "type": "string"
              }
            },
            "required": [
              "member",
              "hours"
            ],
            "title": "Asked",
            "type": "object"
          }
        }
      },
      "required": true
    },
    "responses": {
      "200": {
        "content": {
          "application/json": {
            "schema": {
              "$defs": {
                "Airing": {
                  "additionalProperties": false,
                  "description": "A programme in a channel's guide.",
                  "properties": {
                    "certificate": {
                      "description": "Its certificate, as the server holds it, where it has one.",
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "ends": {
                      "$ref": "#/$defs/Instant",
                      "description": "When it ends."
                    },
                    "starts": {
                      "$ref": "#/$defs/Instant",
                      "description": "When it starts."
                    },
                    "title": {
                      "description": "What it is called.",
                      "type": "string"
                    }
                  },
                  "required": [
                    "title",
                    "starts",
                    "ends"
                  ],
                  "type": "object"
                },
                "Instant": {
                  "description": "A moment, as a whole number of seconds since the Unix epoch.",
                  "format": "uint64",
                  "minimum": 0,
                  "type": "integer"
                },
                "Listing": {
                  "additionalProperties": false,
                  "description": "One channel's guide, as one member's account may watch it: the programmes on it from\nnow across the hours asked, the one on now first.",
                  "properties": {
                    "channel": {
                      "description": "The channel, by the identifier the channels list gives it.",
                      "type": "string"
                    },
                    "programmes": {
                      "description": "Each programme the server's guide holds on it from now across the hours asked, in\nthe order they air, none past where the guide ends, and from minor 6 none the\nserver's own policy keeps from the member's account.",
                      "items": {
                        "$ref": "#/$defs/Airing"
                      },
                      "type": "array"
                    },
                    "until": {
                      "anyOf": [
                        {
                          "$ref": "#/$defs/Instant"
                        },
                        {
                          "type": "null"
                        }
                      ],
                      "description": "From minor 6, where the server's guide ends on it across the hours asked: the end of\nthe last programme it holds there before any is left out, none where it holds none."
                    }
                  },
                  "required": [
                    "channel",
                    "programmes"
                  ],
                  "type": "object"
                }
              },
              "$schema": "https://json-schema.org/draft/2020-12/schema",
              "items": {
                "$ref": "#/$defs/Listing"
              },
              "title": "Array_of_Listing",
              "type": "array"
            }
          }
        },
        "description": "What the operation answers."
      },
      "204": {
        "description": "Answered, with nothing to say."
      },
      "400": {
        "$ref": "../openapi.json#/components/responses/Refused"
      },
      "401": {
        "description": "The plugin's key was absent or wrong."
      },
      "404": {
        "$ref": "../openapi.json#/components/responses/Refused"
      },
      "500": {
        "$ref": "../openapi.json#/components/responses/Refused"
      },
      "502": {
        "$ref": "../openapi.json#/components/responses/Refused"
      },
      "503": {
        "$ref": "../openapi.json#/components/responses/Refused"
      }
    },
    "security": [
      {
        "key": []
      }
    ],
    "x-lemonfiber-deadline": 15,
    "x-lemonfiber-largest": 1048576,
    "x-lemonfiber-since": 5
  }
}
