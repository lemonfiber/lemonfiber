{
  "post": {
    "operationId": "lapses",
    "requestBody": {
      "content": {
        "application/json": {
          "schema": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "additionalProperties": false,
            "description": "What the operation is asked with.",
            "title": "Asked",
            "type": "object"
          }
        }
      },
      "required": true
    },
    "responses": {
      "200": {
        "content": {
          "application/json": {
            "schema": {
              "$defs": {
                "Lapsed": {
                  "additionalProperties": false,
                  "description": "One invitation the service took back, or looked at and left, as its window closed.",
                  "properties": {
                    "account": {
                      "description": "The media server's id for the account made for it.",
                      "type": "string"
                    },
                    "at": {
                      "description": "When it was taken back, in seconds since the Unix epoch.",
                      "format": "uint64",
                      "minimum": 0,
                      "type": "integer"
                    },
                    "issued": {
                      "description": "When it was issued, in seconds since the Unix epoch.",
                      "format": "uint64",
                      "minimum": 0,
                      "type": "integer"
                    },
                    "name": {
                      "description": "The name the account was made under.",
                      "type": "string"
                    },
                    "outcome": {
                      "$ref": "#/$defs/TakenBack",
                      "description": "What became of its account."
                    },
                    "token": {
                      "description": "The SHA-256 of its decline token, in lower-case hexadecimal.",
                      "type": "string"
                    }
                  },
                  "required": [
                    "token",
                    "account",
                    "name",
                    "issued",
                    "at",
                    "outcome"
                  ],
                  "type": "object"
                },
                "LeftBecause": {
                  "description": "Why the service left an account as it was when its invitation's window closed.",
                  "oneOf": [
                    {
                      "const": "claimed",
                      "description": "Somebody had set a password on it since the invitation was issued.",
                      "type": "string"
                    },
                    {
                      "const": "administrator",
                      "description": "It administers the server.",
                      "type": "string"
                    },
                    {
                      "const": "disabled",
                      "description": "It was already switched off.",
                      "type": "string"
                    },
                    {
                      "const": "gone",
                      "description": "The server no longer held it.",
                      "type": "string"
                    },
                    {
                      "const": "reoffered",
                      "description": "The invitation was offered again under another issue time.",
                      "type": "string"
                    },
                    {
                      "const": "unmatched",
                      "description": "The server answered for an account other than the one asked for.",
                      "type": "string"
                    }
                  ]
                },
                "TakenBack": {
                  "description": "What the service did with an account when its invitation's window closed.",
                  "oneOf": [
                    {
                      "const": "removed",
                      "description": "Nobody was ever seen in it and every guard held: it was removed.",
                      "type": "string"
                    },
                    {
                      "const": "switched-off",
                      "description": "Somebody had been in it, or a guard did not hold: it was switched off and kept.",
                      "type": "string"
                    },
                    {
                      "additionalProperties": false,
                      "description": "It was left as it was.",
                      "properties": {
                        "left": {
                          "additionalProperties": false,
                          "properties": {
                            "why": {
                              "$ref": "#/$defs/LeftBecause",
                              "description": "Why."
                            }
                          },
                          "required": [
                            "why"
                          ],
                          "type": "object"
                        }
                      },
                      "required": [
                        "left"
                      ],
                      "type": "object"
                    }
                  ]
                }
              },
              "$schema": "https://json-schema.org/draft/2020-12/schema",
              "items": {
                "$ref": "#/$defs/Lapsed"
              },
              "title": "Array_of_Lapsed",
              "type": "array"
            }
          }
        },
        "description": "What the operation answers."
      },
      "204": {
        "description": "Answered, with nothing to say."
      },
      "400": {
        "$ref": "../openapi.json#/components/responses/Refused"
      },
      "401": {
        "description": "The plugin's key was absent or wrong."
      },
      "404": {
        "$ref": "../openapi.json#/components/responses/Refused"
      },
      "500": {
        "$ref": "../openapi.json#/components/responses/Refused"
      },
      "502": {
        "$ref": "../openapi.json#/components/responses/Refused"
      },
      "503": {
        "$ref": "../openapi.json#/components/responses/Refused"
      }
    },
    "security": [
      {
        "key": []
      }
    ],
    "x-lemonfiber-deadline": 15,
    "x-lemonfiber-largest": 1048576
  }
}
