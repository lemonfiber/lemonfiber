{
  "post": {
    "operationId": "apply_invitations",
    "requestBody": {
      "content": {
        "application/json": {
          "schema": {
            "$defs": {
              "Declinable": {
                "additionalProperties": false,
                "description": "One invitation the service may decline.",
                "properties": {
                  "account": {
                    "description": "The media server's id for the account made for it.",
                    "type": "string"
                  },
                  "lapses": {
                    "description": "When it lapses, in seconds since the Unix epoch.",
                    "format": "uint64",
                    "minimum": 0,
                    "type": "integer"
                  },
                  "token": {
                    "description": "The SHA-256 of its decline token, in lower-case hexadecimal.",
                    "type": "string"
                  }
                },
                "required": [
                  "token",
                  "account",
                  "lapses"
                ],
                "type": "object"
              }
            },
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "additionalProperties": false,
            "description": "What the operation is asked with.",
            "properties": {
              "invitations": {
                "description": "The port's `invitations`.",
                "items": {
                  "$ref": "#/$defs/Declinable"
                },
                "type": "array"
              }
            },
            "required": [
              "invitations"
            ],
            "title": "Asked",
            "type": "object"
          }
        }
      },
      "required": true
    },
    "responses": {
