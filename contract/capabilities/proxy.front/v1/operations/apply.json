{
  "post": {
    "operationId": "apply",
    "requestBody": {
      "content": {
        "application/json": {
          "schema": {
            "$defs": {
              "Route": {
                "additionalProperties": false,
                "description": "One household name the proxy answers, and the service it forwards to.",
                "properties": {
                  "host": {
                    "description": "The host the service answers on, on the network the proxy shares with it.",
                    "type": "string"
                  },
                  "name": {
                    "description": "The household name, the operator's domain included.",
                    "type": "string"
                  },
                  "port": {
                    "description": "The port the service listens on there.",
                    "format": "uint16",
                    "maximum": 65535,
                    "minimum": 0,
                    "type": "integer"
                  }
                },
                "required": [
                  "name",
                  "host",
                  "port"
                ],
                "type": "object"
              },
              "Routing": {
                "additionalProperties": false,
                "description": "Every route the proxy serves, and its TLS.",
                "properties": {
                  "routes": {
                    "description": "Every name it answers, in the order applied.",
                    "items": {
                      "$ref": "#/$defs/Route"
                    },
                    "type": "array"
                  },
                  "tls": {
                    "$ref": "#/$defs/Tls",
                    "description": "How it holds TLS."
                  }
                },
                "required": [
                  "tls",
                  "routes"
                ],
                "type": "object"
              },
              "Tls": {
                "description": "How the proxy holds TLS for every name it answers.",
                "oneOf": [
                  {
                    "const": "automatic",
                    "description": "The proxy obtains a certificate for each name itself where an authority issues one.",
                    "type": "string"
                  },
                  {
                    "additionalProperties": false,
                    "description": "The certificate and key in these files, beneath the proxy's configuration directory.",
                    "properties": {
                      "files": {
                        "additionalProperties": false,
                        "properties": {
                          "certificate": {
                            "description": "The certificate chain.",
                            "type": "string"
                          },
                          "key": {
                            "description": "Its private key.",
                            "type": "string"
                          }
                        },
                        "required": [
                          "certificate",
                          "key"
                        ],
                        "type": "object"
                      }
                    },
                    "required": [
                      "files"
                    ],
                    "type": "object"
                  }
                ]
              }
            },
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "additionalProperties": false,
            "description": "What the operation is asked with.",
            "properties": {
              "table": {
                "$ref": "#/$defs/Routing",
                "description": "The port's `table`."
              }
            },
            "required": [
              "table"
            ],
            "title": "Asked",
            "type": "object"
          }
        }
      },
      "required": true
    },
    "responses": {
      "200": {
        "content": {
          "application/json": {
            "schema": {
              "$defs": {
                "Restart": {
                  "description": "What an operation applied that is in force only once the upstream restarts says.",
                  "oneOf": [
                    {
                      "const": "on-restart",
                      "description": "In force once the upstream restarts.",
                      "type": "string"
                    }
                  ]
                }
              },
              "$schema": "https://json-schema.org/draft/2020-12/schema",
              "anyOf": [
                {
                  "$ref": "#/$defs/Restart"
                },
                {
                  "type": "null"
                }
              ],
              "description": "When what an operation applied is in force.\n\nIt crosses as `null` where it is in force at once, and as `\"on-restart\"` where it is in\nforce once the upstream restarts, which an adapter answers as `205`.",
              "title": "Applied"
            }
          }
        },
        "description": "What the operation answers."
      },
      "204": {
        "description": "Answered, with nothing to say."
      },
      "205": {
        "description": "Applied, and in force once the upstream restarts."
      },
      "400": {
        "$ref": "../openapi.json#/components/responses/Refused"
      },
      "401": {
        "description": "The plugin's key was absent or wrong."
      },
      "404": {
        "$ref": "../openapi.json#/components/responses/Refused"
      },
      "500": {
        "$ref": "../openapi.json#/components/responses/Refused"
      },
      "502": {
        "$ref": "../openapi.json#/components/responses/Refused"
      },
      "503": {
        "$ref": "../openapi.json#/components/responses/Refused"
      }
    },
    "security": [
      {
        "key": []
      }
    ],
    "x-lemonfiber-deadline": 15,
    "x-lemonfiber-largest": 1048576
  }
}
