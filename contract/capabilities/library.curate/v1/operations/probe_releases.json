{
  "post": {
    "operationId": "probe_releases",
    "requestBody": {
      "content": {
        "application/json": {
          "schema": {
            "$defs": {
              "TitleKind": {
                "description": "What kind of title a curator files, a member asks for and a media server holds: a\nseries, a film, music or books.",
                "oneOf": [
                  {
                    "const": "tv",
                    "description": "A series.",
                    "type": "string"
                  },
                  {
                    "const": "movies",
                    "description": "A film.",
                    "type": "string"
                  },
                  {
                    "const": "music",
                    "description": "An album, or a whole artist asked for.",
                    "type": "string"
                  },
                  {
                    "const": "books",
                    "description": "A book, or a whole author or series of books asked for.",
                    "type": "string"
                  }
                ]
              }
            },
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "additionalProperties": false,
            "description": "What the operation is asked with.",
            "properties": {
              "kind": {
                "$ref": "#/$defs/TitleKind",
                "description": "The port's `kind`."
              }
            },
            "required": [
              "kind"
            ],
            "title": "Asked",
            "type": "object"
          }
        }
      },
      "required": true
    },
    "responses": {
      "200": {
        "content": {
          "application/json": {
            "schema": {
              "$schema": "https://json-schema.org/draft/2020-12/schema",
              "description": "What a search for the operator's wanted content found, read against the quality\nprofile in force — the basis for telling \"the preset yields no matching releases\"\napart from \"the indexer failed\" (which surfaces as a [`Failure`], not a probe).",
              "oneOf": [
                {
                  "const": "nothing-wanted",
                  "description": "Nothing is wanted, so there was nothing to search for — the preset cannot be\njudged against releases yet.",
                  "type": "string"
                },
                {
                  "const": "matching",
                  "description": "The search ran and returned releases the profile would grab — the preset is\nmet by what is available.",
                  "type": "string"
                },
                {
                  "const": "none-match",
                  "description": "The search returned releases, but the profile wants none of them — they exist\nbut do not meet the chosen quality, so the preset conflicts with what is out\nthere.",
                  "type": "string"
                },
                {
                  "const": "none-found",
                  "description": "The search ran cleanly and returned nothing at all — few or none are available,\nas distinct from the indexer having failed to answer.",
                  "type": "string"
                }
              ],
              "title": "ReleaseProbe"
            }
          }
        },
        "description": "What the operation answers."
      },
      "204": {
        "description": "Answered, with nothing to say."
      },
      "400": {
        "$ref": "../openapi.json#/components/responses/Refused"
      },
      "401": {
        "description": "The plugin's key was absent or wrong."
      },
      "404": {
        "$ref": "../openapi.json#/components/responses/Refused"
      },
      "500": {
        "$ref": "../openapi.json#/components/responses/Refused"
      },
      "502": {
        "$ref": "../openapi.json#/components/responses/Refused"
      },
      "503": {
        "$ref": "../openapi.json#/components/responses/Refused"
      }
    },
    "security": [
      {
        "key": []
      }
    ],
    "x-lemonfiber-deadline": 15,
    "x-lemonfiber-largest": 1048576,
    "x-lemonfiber-since": 0
  }
}
