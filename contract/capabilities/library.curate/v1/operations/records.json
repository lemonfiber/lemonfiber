{
  "post": {
    "operationId": "records",
    "requestBody": {
      "content": {
        "application/json": {
          "schema": {
            "$defs": {
              "Record": {
                "description": "A kind of record a service holds, for carrying a setup across.\n\nFour, because four are what an operator would miss: where things are found, and the\nthree libraries the *arrs keep. Each is a path under the same API and behaves the\nsame way, which is why one port serves all of them.",
                "oneOf": [
                  {
                    "const": "indexer",
                    "description": "Where releases are searched for.",
                    "type": "string"
                  },
                  {
                    "const": "series",
                    "description": "Television the service is following.",
                    "type": "string"
                  },
                  {
                    "const": "film",
                    "description": "Films the service is following.",
                    "type": "string"
                  },
                  {
                    "const": "artist",
                    "description": "Music the service is following.",
                    "type": "string"
                  }
                ]
              }
            },
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "additionalProperties": false,
            "description": "What the operation is asked with.",
            "properties": {
              "sort": {
                "$ref": "#/$defs/Record",
                "description": "The port's `sort`."
              }
            },
            "required": [
              "sort"
            ],
            "title": "Asked",
            "type": "object"
          }
        }
      },
      "required": true
    },
    "responses": {
      "200": {
        "content": {
          "application/json": {
            "schema": {
              "$defs": {
                "Carried": {
                  "additionalProperties": false,
                  "description": "One record a service holds, as it holds it.\n\nThe profile and the folder are carried **by name and by path**, never by the ids the\nservice gave them. Two stacks number their own profiles and folders independently, so\na record copied with its ids intact would point at whatever happened to be third on\nthe other machine — which is the quiet way an import ruins a library rather than\nfailing to copy it.",
                  "properties": {
                    "folder": {
                      "description": "The root folder it sits under, by path.",
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "name": {
                      "description": "What it is called, which is how a copy already here is recognised.",
                      "type": "string"
                    },
                    "profile": {
                      "description": "The quality profile it follows, by name.",
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "rest": {
                      "description": "Everything else the service said about it, kept as it was said.",
                      "type": "string"
                    }
                  },
                  "required": [
                    "name",
                    "rest"
                  ],
                  "type": "object"
                }
              },
              "$schema": "https://json-schema.org/draft/2020-12/schema",
              "items": {
                "$ref": "#/$defs/Carried"
              },
              "title": "Array_of_Carried",
              "type": "array"
            }
          }
        },
        "description": "What the operation answers."
      },
      "204": {
        "description": "Answered, with nothing to say."
      },
      "400": {
        "$ref": "../openapi.json#/components/responses/Refused"
      },
      "401": {
        "description": "The plugin's key was absent or wrong."
      },
      "404": {
        "$ref": "../openapi.json#/components/responses/Refused"
      },
      "500": {
        "$ref": "../openapi.json#/components/responses/Refused"
      },
      "502": {
        "$ref": "../openapi.json#/components/responses/Refused"
      },
      "503": {
        "$ref": "../openapi.json#/components/responses/Refused"
      }
    },
    "security": [
      {
        "key": []
      }
    ],
    "x-lemonfiber-largest": 1048576
  }
}
