{
  "post": {
    "operationId": "stuck_items",
    "requestBody": {
      "content": {
        "application/json": {
          "schema": {
            "$defs": {
              "Kind": {
                "description": "The two kinds of video a household files by resolution.",
                "oneOf": [
                  {
                    "const": "tv",
                    "description": "Television: series, seasons and episodes.",
                    "type": "string"
                  },
                  {
                    "const": "movies",
                    "description": "Film.",
                    "type": "string"
                  }
                ]
              }
            },
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "additionalProperties": false,
            "description": "What the operation is asked with.",
            "properties": {
              "kind": {
                "$ref": "#/$defs/Kind",
                "description": "The port's `kind`."
              }
            },
            "required": [
              "kind"
            ],
            "title": "Asked",
            "type": "object"
          }
        }
      },
      "required": true
    },
    "responses": {
      "200": {
        "content": {
          "application/json": {
            "schema": {
              "$defs": {
                "Stage": {
                  "description": "A stage in an item's journey, ordered from \"nobody asked for it\" to \"playable\". The\ndeclaration order is the pipeline order, so one stage compares less than a later one.",
                  "oneOf": [
                    {
                      "const": "not-monitored",
                      "description": "Nobody has asked for it — no \\*arr is monitoring it.",
                      "type": "string"
                    },
                    {
                      "const": "monitored",
                      "description": "Monitored, waiting to be searched for.",
                      "type": "string"
                    },
                    {
                      "const": "searching",
                      "description": "A search is running.",
                      "type": "string"
                    },
                    {
                      "const": "found",
                      "description": "Releases were found by an indexer.",
                      "type": "string"
                    },
                    {
                      "const": "grabbed",
                      "description": "A release was sent to the download client.",
                      "type": "string"
                    },
                    {
                      "const": "downloading",
                      "description": "The download is in progress.",
                      "type": "string"
                    },
                    {
                      "const": "downloaded",
                      "description": "The download finished.",
                      "type": "string"
                    },
                    {
                      "const": "importing",
                      "description": "The \\*arr is importing it to the library.",
                      "type": "string"
                    },
                    {
                      "const": "imported",
                      "description": "It was imported to the library on disk.",
                      "type": "string"
                    },
                    {
                      "const": "available",
                      "description": "It is visible and playable in the media server.",
                      "type": "string"
                    }
                  ]
                },
                "StuckItem": {
                  "additionalProperties": false,
                  "description": "A stuck item the queue is holding — one queue health reports so it can be traced. Its\ntitle is the human term a trace searches by, so \"3 items stuck\" leads straight to the\nper-item explanation rather than to a count the operator must go and investigate.",
                  "properties": {
                    "stage": {
                      "$ref": "#/$defs/Stage",
                      "description": "The stage its download is stuck at."
                    },
                    "title": {
                      "description": "The item's title, as a person would name it — the term its trace is searched by.",
                      "type": "string"
                    }
                  },
                  "required": [
                    "title",
                    "stage"
                  ],
                  "type": "object"
                }
              },
              "$schema": "https://json-schema.org/draft/2020-12/schema",
              "items": {
                "$ref": "#/$defs/StuckItem"
              },
              "title": "Array_of_StuckItem",
              "type": "array"
            }
          }
        },
        "description": "What the operation answers."
      },
      "204": {
        "description": "Answered, with nothing to say."
      },
      "400": {
        "$ref": "../openapi.json#/components/responses/Refused"
      },
      "401": {
        "description": "The plugin's key was absent or wrong."
      },
      "404": {
        "$ref": "../openapi.json#/components/responses/Refused"
      },
      "500": {
        "$ref": "../openapi.json#/components/responses/Refused"
      },
      "502": {
        "$ref": "../openapi.json#/components/responses/Refused"
      },
      "503": {
        "$ref": "../openapi.json#/components/responses/Refused"
      }
    },
    "security": [
      {
        "key": []
      }
    ]
  }
}
