{
  "post": {
    "operationId": "item_parts",
    "requestBody": {
      "content": {
        "application/json": {
          "schema": {
            "$defs": {
              "Kind": {
                "description": "The two kinds of video a household files by resolution.",
                "oneOf": [
                  {
                    "const": "tv",
                    "description": "Television: series, seasons and episodes.",
                    "type": "string"
                  },
                  {
                    "const": "movies",
                    "description": "Film.",
                    "type": "string"
                  }
                ]
              }
            },
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "additionalProperties": false,
            "description": "What the operation is asked with.",
            "properties": {
              "id": {
                "description": "The port's `id`.",
                "format": "int64",
                "type": "integer"
              },
              "kind": {
                "$ref": "#/$defs/Kind",
                "description": "The port's `kind`."
              },
              "season": {
                "description": "The port's `season`.",
                "format": "uint32",
                "minimum": 0,
                "type": [
                  "integer",
                  "null"
                ]
              }
            },
            "required": [
              "kind",
              "id"
            ],
            "title": "Asked",
            "type": "object"
          }
        }
      },
      "required": true
    },
    "responses": {
      "200": {
        "content": {
          "application/json": {
            "schema": {
              "$defs": {
                "ItemPart": {
                  "additionalProperties": false,
                  "description": "One part of a library item as the service records it now — an episode of a series.\n\nOnly what the listing genuinely carries: the file and the monitored flag. Whether a\nrelease was grabbed is deliberately not here — the television service defines such a\nfield on its episode type but never populates it on this listing, so reading it would\nhave reported every grabbed episode as one the indexers never found.",
                  "properties": {
                    "has_file": {
                      "description": "Whether its file is on disk.",
                      "type": "boolean"
                    },
                    "id": {
                      "description": "The service's own id for the part, which its queue records name.",
                      "format": "int64",
                      "type": "integer"
                    },
                    "monitored": {
                      "description": "Whether the service is monitoring it — whether anyone asked for this part.",
                      "type": "boolean"
                    },
                    "number": {
                      "description": "Its number within that season.",
                      "format": "uint32",
                      "minimum": 0,
                      "type": "integer"
                    },
                    "season": {
                      "description": "The season it belongs to. Season zero is where a service files specials.",
                      "format": "uint32",
                      "minimum": 0,
                      "type": "integer"
                    },
                    "title": {
                      "description": "Its title, as a person would name it.",
                      "type": "string"
                    }
                  },
                  "required": [
                    "id",
                    "season",
                    "number",
                    "title",
                    "monitored",
                    "has_file"
                  ],
                  "type": "object"
                }
              },
              "$schema": "https://json-schema.org/draft/2020-12/schema",
              "items": {
                "$ref": "#/$defs/ItemPart"
              },
              "title": "Array_of_ItemPart",
              "type": "array"
            }
          }
        },
        "description": "What the operation answers."
      },
      "204": {
        "description": "Answered, with nothing to say."
      },
      "400": {
        "$ref": "../openapi.json#/components/responses/Refused"
      },
      "401": {
        "description": "The plugin's key was absent or wrong."
      },
      "404": {
        "$ref": "../openapi.json#/components/responses/Refused"
      },
      "500": {
        "$ref": "../openapi.json#/components/responses/Refused"
      },
      "502": {
        "$ref": "../openapi.json#/components/responses/Refused"
      },
      "503": {
        "$ref": "../openapi.json#/components/responses/Refused"
      }
    },
    "security": [
      {
        "key": []
      }
    ]
  }
}
