{
  "post": {
    "operationId": "root_folders",
    "requestBody": {
      "content": {
        "application/json": {
          "schema": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "additionalProperties": false,
            "description": "What the operation is asked with.",
            "title": "Asked",
            "type": "object"
          }
        }
      },
      "required": true
    },
    "responses": {
      "200": {
        "content": {
          "application/json": {
            "schema": {
              "$defs": {
                "RegisteredFolder": {
                  "additionalProperties": false,
                  "description": "A root folder a service already holds, with the identifier it gave it.\n\nRead back so an absent connection can be told from one already made — matched\nby path, not by any label — and so a later undo names exactly the one created.",
                  "properties": {
                    "id": {
                      "description": "The identifier the service assigned.",
                      "type": "string"
                    },
                    "path": {
                      "description": "The path it holds.",
                      "type": "string"
                    }
                  },
                  "required": [
                    "id",
                    "path"
                  ],
                  "type": "object"
                }
              },
              "$schema": "https://json-schema.org/draft/2020-12/schema",
              "items": {
                "$ref": "#/$defs/RegisteredFolder"
              },
              "title": "Array_of_RegisteredFolder",
              "type": "array"
            }
          }
        },
        "description": "What the operation answers."
      },
      "204": {
        "description": "Answered, with nothing to say."
      },
      "400": {
        "$ref": "../openapi.json#/components/responses/Refused"
      },
      "401": {
        "description": "The plugin's key was absent or wrong."
