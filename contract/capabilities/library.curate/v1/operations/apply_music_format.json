{
  "post": {
    "operationId": "apply_music_format",
    "requestBody": {
      "content": {
        "application/json": {
          "schema": {
            "$defs": {
              "Format": {
                "description": "How good the operator wants their music to sound, and how much disk they will\nspend on it — chosen as a format preference, since music has no resolution to\nchoose.",
                "oneOf": [
                  {
                    "const": "compact",
                    "description": "Small lossy files that sound great on phones, earbuds, and in the car:\nMP3/AAC at 320 kbps.",
                    "type": "string"
                  },
                  {
                    "const": "lossless",
                    "description": "A perfect copy of the CD, every bit kept: lossless FLAC or ALAC. The one\nchosen when the operator expresses no preference — the reason to keep a\nmusic library rather than stream it.",
                    "type": "string"
                  },
                  {
                    "const": "hi-res",
                    "description": "Studio-master quality where it exists, for a good hi-fi: 24-bit lossless.",
                    "type": "string"
                  }
                ]
              }
            },
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "additionalProperties": false,
            "description": "What the operation is asked with.",
            "properties": {
              "format": {
                "$ref": "#/$defs/Format",
                "description": "The port's `format`."
              }
            },
            "required": [
              "format"
            ],
            "title": "Asked",
            "type": "object"
          }
        }
      },
      "required": true
    },
    "responses": {
      "200": {
        "content": {
          "application/json": {
            "schema": {
              "$schema": "https://json-schema.org/draft/2020-12/schema",
              "title": "null",
              "type": "null"
            }
          }
        },
        "description": "What the operation answers."
      },
      "204": {
        "description": "Answered, with nothing to say."
      },
      "400": {
        "$ref": "../openapi.json#/components/responses/Refused"
      },
      "401": {
        "description": "The plugin's key was absent or wrong."
      },
      "404": {
        "$ref": "../openapi.json#/components/responses/Refused"
      },
      "500": {
        "$ref": "../openapi.json#/components/responses/Refused"
      },
      "502": {
        "$ref": "../openapi.json#/components/responses/Refused"
      },
      "503": {
        "$ref": "../openapi.json#/components/responses/Refused"
      }
    },
    "security": [
