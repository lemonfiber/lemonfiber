{
  "post": {
    "operationId": "find_items",
    "requestBody": {
      "content": {
        "application/json": {
          "schema": {
            "$defs": {
              "Kind": {
                "description": "The two kinds of video a household files by resolution.",
                "oneOf": [
                  {
                    "const": "tv",
                    "description": "Television: series, seasons and episodes.",
                    "type": "string"
                  },
                  {
                    "const": "movies",
                    "description": "Film.",
                    "type": "string"
                  }
                ]
              }
            },
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "additionalProperties": false,
            "description": "What the operation is asked with.",
            "properties": {
              "kind": {
                "$ref": "#/$defs/Kind",
                "description": "The port's `kind`."
              },
              "term": {
                "description": "The port's `term`.",
                "type": "string"
              }
            },
            "required": [
              "kind",
              "term"
            ],
            "title": "Asked",
            "type": "object"
          }
        }
      },
      "required": true
    },
    "responses": {
      "200": {
        "content": {
          "application/json": {
            "schema": {
              "$defs": {
                "FoundItem": {
                  "additionalProperties": false,
                  "description": "One library item a trace could follow: its id, the title it was found by, and\nwhether the service is monitoring it — the entry point for \"where is my show?\".",
                  "properties": {
                    "id": {
                      "description": "The service's own id for the item, used to read its history.",
                      "format": "int64",
                      "type": "integer"
                    },
                    "monitored": {
                      "description": "Whether the service is monitoring it — an unmonitored item is one nobody asked\nfor, the first of the stages a trace tells apart.",
                      "type": "boolean"
                    },
                    "title": {
                      "description": "The item's title, as a person would name it.",
                      "type": "string"
                    },
                    "year": {
                      "description": "The year it came out, where the service knows one.",
                      "format": "uint16",
                      "maximum": 65535,
                      "minimum": 0,
                      "type": [
                        "integer",
                        "null"
                      ]
                    }
                  },
                  "required": [
                    "id",
                    "title",
                    "monitored"
                  ],
                  "type": "object"
                }
              },
              "$schema": "https://json-schema.org/draft/2020-12/schema",
              "items": {
                "$ref": "#/$defs/FoundItem"
              },
              "title": "Array_of_FoundItem",
              "type": "array"
            }
          }
        },
        "description": "What the operation answers."
      },
      "204": {
        "description": "Answered, with nothing to say."
      },
      "400": {
        "$ref": "../openapi.json#/components/responses/Refused"
      },
      "401": {
        "description": "The plugin's key was absent or wrong."
      },
      "404": {
        "$ref": "../openapi.json#/components/responses/Refused"
      },
      "500": {
        "$ref": "../openapi.json#/components/responses/Refused"
      },
      "502": {
        "$ref": "../openapi.json#/components/responses/Refused"
      },
      "503": {
        "$ref": "../openapi.json#/components/responses/Refused"
      }
    },
    "security": [
      {
        "key": []
      }
    ],
    "x-lemonfiber-largest": 1048576
  }
}
