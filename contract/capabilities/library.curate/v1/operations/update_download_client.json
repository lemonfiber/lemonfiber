{
  "post": {
    "operationId": "update_download_client",
    "requestBody": {
      "content": {
        "application/json": {
          "schema": {
            "$defs": {
              "Category": {
                "additionalProperties": false,
                "description": "The category a download is filed under, named after the media the requesting\napplication manages.\n\nEach curator names the field after the media it files, so it travels with the\nclient rather than being assumed by the writer.",
                "properties": {
                  "field": {
                    "description": "The field the target application names its category.",
                    "type": "string"
                  },
                  "value": {
                    "description": "The value a download is filed under.",
                    "type": "string"
                  }
                },
                "required": [
                  "field",
                  "value"
                ],
                "type": "object"
              },
              "Credential": {
                "description": "How a service proves itself: a single API key, or a username and its password.",
                "oneOf": [
                  {
                    "additionalProperties": false,
                    "description": "A single API key.",
                    "properties": {
                      "api-key": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "api-key"
                    ],
                    "type": "object"
                  },
                  {
                    "additionalProperties": false,
                    "description": "A username and its password.",
                    "properties": {
                      "user-pass": {
                        "properties": {
                          "password": {
                            "description": "Its password.",
                            "type": "string"
                          },
                          "username": {
                            "description": "The account name.",
                            "type": "string"
                          }
                        },
                        "required": [
                          "username",
                          "password"
                        ],
                        "type": "object"
                      }
                    },
                    "required": [
                      "user-pass"
                    ],
                    "type": "object"
                  }
                ]
              },
              "DownloadClient": {
                "additionalProperties": false,
                "description": "A download client, as one service needs to be told about another.",
                "properties": {
                  "category": {
                    "$ref": "#/$defs/Category",
                    "description": "The category the requesting application files its downloads under."
                  },
                  "credential": {
                    "$ref": "#/$defs/Credential",
                    "description": "How the service authenticates to it."
                  },
                  "host": {
                    "description": "The host the service should reach it on.",
                    "type": "string"
                  },
                  "name": {
                    "description": "The name the operator will see in the service's own interface.",
                    "type": "string"
                  },
                  "port": {
                    "description": "The port it listens on.",
                    "format": "uint16",
                    "maximum": 65535,
                    "minimum": 0,
                    "type": "integer"
                  },
                  "protocol": {
                    "$ref": "#/$defs/Protocol",
                    "description": "The protocol it is reached in."
                  }
                },
                "required": [
                  "name",
                  "host",
                  "port",
                  "protocol",
                  "credential",
                  "category"
                ],
                "type": "object"
              },
              "Protocol": {
                "description": "The protocol a download client is reached in: the name of the API a curator speaks\nto it, as the download client declares it.",
                "type": "string"
              }
            },
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "additionalProperties": false,
            "description": "What the operation is asked with.",
            "properties": {
              "client": {
                "$ref": "#/$defs/DownloadClient",
                "description": "The port's `client`."
              },
              "id": {
                "description": "The port's `id`.",
                "type": "string"
              }
            },
            "required": [
              "id",
              "client"
            ],
            "title": "Asked",
            "type": "object"
          }
        }
      },
      "required": true
    },
    "responses": {
      "200": {
        "content": {
          "application/json": {
            "schema": {
              "$schema": "https://json-schema.org/draft/2020-12/schema",
              "title": "null",
              "type": "null"
            }
          }
        },
        "description": "What the operation answers."
      },
      "204": {
        "description": "Answered, with nothing to say."
      },
      "400": {
        "$ref": "../openapi.json#/components/responses/Refused"
      },
      "401": {
        "description": "The plugin's key was absent or wrong."
      },
      "404": {
        "$ref": "../openapi.json#/components/responses/Refused"
      },
      "500": {
        "$ref": "../openapi.json#/components/responses/Refused"
      },
      "502": {
        "$ref": "../openapi.json#/components/responses/Refused"
      },
      "503": {
        "$ref": "../openapi.json#/components/responses/Refused"
      }
    },
    "security": [
      {
        "key": []
      }
    ]
  }
}
