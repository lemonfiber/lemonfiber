# Copy to .env and edit. Every variable the stack reads is listed here; anything
# with a sensible default is already set to it, so the shortest working file is
# DATA_ROOT plus, if you want torrents, a WireGuard key.

# ── Core ──────────────────────────────────────────────────────────────────
# The single data root. Downloads AND media live under here as subdirectories,
# on ONE filesystem, so imports hardlink instead of copy. Splitting them across
# two mounts silently turns every import into a copy — slower, and twice the
# disk while it runs.
DATA_ROOT=./data

# The user that owns everything under DATA_ROOT. `id -u` and `id -g`.
PUID=1000
PGID=1000
TZ=Europe/Amsterdam

# ── Binding ───────────────────────────────────────────────────────────────
# Admin services — the *arrs, SABnzbd, qBittorrent, Prowlarr, NZBHydra2,
# FlareSolverr, Bindery — are always on 127.0.0.1 and are not configurable here.
# They hold full control of the stack and most ship with weak or disabled
# default authentication.
#
# Household services — Jellyfin's door, Seerr, Calibre-Web-Automated,
# Audiobookshelf, Navidrome, Homepage and Caddy — are published on LAN_BIND,
# because a library the TV cannot reach is not a library. Jellyfin itself is on
# 127.0.0.1:8095: the door publishes its ports, 8096 and 8920, and guards every
# byte it serves. `bind` in stack.toml is the list of record for both tiers.
#
# 0.0.0.0 means every interface on this machine. Narrow it to the one address
# the household actually uses, e.g. LAN_BIND=192.168.1.10. Two things worth
# knowing: Docker's port publishing bypasses some host firewalls, so a rule you
# added may not apply here; and the LAN tier assumes the network is trusted,
# which a café or a shared flat is not.
LAN_BIND=0.0.0.0

# ── VPN (torrents) ────────────────────────────────────────────────────────
# Gluetun supports ~24 providers. Only ProtonVPN, PIA, PrivateVPN and Perfect
# Privacy support port forwarding; leave VPN_PORT_FORWARDING off for others,
# where the port machinery simply does not run.
VPN_PROVIDER=protonvpn
WIREGUARD_PRIVATE_KEY=
VPN_COUNTRIES=Netherlands

# ProtonVPN, concretely: account.protonvpn.com -> Downloads -> WireGuard
# configuration. Under "Select VPN options" enable NAT-PMP (port forwarding),
# then pick a server marked P2P. WIREGUARD_PRIVATE_KEY is the PrivateKey line of
# the file you download.
#
# Both choices are made when the configuration is GENERATED and cannot be
# changed afterwards. Get either wrong and the tunnel still connects perfectly —
# only the forwarded port never arrives, which looks like a stack fault and is
# not one. The remedy is new credentials.
#
# Turning this on also restricts server selection to servers that can forward,
# so a country with no such server will fail to connect rather than connect
# without a port.
VPN_PORT_FORWARDING=on

# The forwarded port has to be pushed into qBittorrent, whose WebUI API refuses
# unauthenticated calls. qBittorrent prints a temporary password on first boot
# and asks you to replace it; once you have, put the same password here and the
# port is set on every connect and released on every drop.
#
# Until this is set, the tunnel and the killswitch work normally and the port is
# simply not applied — the log says so on each connect. Avoid `&` and `=` in the
# password: it is submitted as form data and neither is escaped.
QBITTORRENT_USERNAME=admin
QBITTORRENT_PASSWORD=

# ── Service tuning ────────────────────────────────────────────────────────
# Umask for files Unpackerr extracts. 002 leaves them group-writable so the
# *arrs can import them.
UMASK=002
FLARESOLVERR_LOG_LEVEL=info
SEERR_LOG_LEVEL=info
# When Recyclarr syncs quality profiles. Cron expression or @daily / @weekly.
RECYCLARR_CRON=@daily

# The host's render group id, given with the host's render devices to a service
# that takes the `render` shape:
#   getent group render | cut -d: -f3
# Jellyfin takes none here. Its hardware transcoding goes in overlay.yml beside
# lemonfiber's settings, which the project's .env names to Compose.
# RENDER_GID=

# ── Homepage (dash profile) ───────────────────────────────────────────────
# The Host headers Homepage will answer for. List every address the household
# types, comma-separated.
HOMEPAGE_ALLOWED_HOSTS=localhost:3000
# What the dashboard's household links point at — the address a phone can
# reach, not the address of the container.
HOMEPAGE_VAR_LAN_HOST=localhost

# ── Seeded credentials ────────────────────────────────────────────────────
# Empty by design. `lemonfiber seed` reads each service's own config file and
# fills these in; until then, Recyclarr logs an authentication failure each
# cycle, and Unpackerr idles. Nothing here is required for the stack to start.
# The dashboard reads none of them.
#
# Setting them by hand is supported — each app shows its key under
# Settings → General.
SONARR_API_KEY=
RADARR_API_KEY=
LIDARR_API_KEY=

# Bindery's key, which it takes as its own on its first start and ignores on
# every start after. Minted before that start rather than while seeding.
BINDERY_API_KEY=

# ── Proxy overlay (proxy profile, off by default) ─────────────────────────
# A domain whose DNS points at this machine. Caddy then obtains real
# certificates automatically — see config/caddy/Caddyfile for which hostnames
# it serves, and which are deliberately left disabled. Left unset, Caddy serves
# the household services over plain HTTP on home.local.
DOMAIN=home.example
